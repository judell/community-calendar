{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://judell.github.io/community-calendar/report-schema.json",
  "title": "Calendar Audit Report Front Matter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "title",
    "city",
    "date",
    "commit",
    "overall_status",
    "summary",
    "findings",
    "actions",
    "artifacts"
  ],
  "properties": {
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "city": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "overall_status": {
      "enum": [
        "pass",
        "partial",
        "fail",
        "warning",
        "pending"
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_checks",
        "passed",
        "failed",
        "warning"
      ],
      "properties": {
        "total_checks": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "warning": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "ref"
      ],
      "properties": {
        "type": {
          "enum": [
            "workflow",
            "github-run",
            "log",
            "report",
            "file",
            "issue",
            "url"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "title",
        "scope",
        "evidence",
        "action_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^F[0-9]{3}$"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "warning",
            "pending",
            "info"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "action_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^A[0-9]{3}$"
          }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "title",
        "owner"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^A[0-9]{3}$"
        },
        "status": {
          "enum": [
            "open",
            "blocked",
            "done",
            "deferred"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "type",
        "ref"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "github-run",
            "log",
            "report",
            "file",
            "url"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

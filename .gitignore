*.sh
!cities/*/test.sh
!scripts/local_regression_test.sh
!scripts/align-fork.sh
!scripts/verify_edge_functions.sh
!tests/sql/*.sh
.jsonsupabase/.temp/
supabase/.temp/
xmlui/supabase.min.js
__pycache__/
CLAUDE.md
PENDING.md

# secrets — API keys etc. live in .env (never committed)
.env
.env.*
!.env.example
sb.sh
local-overrides.js

# trace-tools is cloned at test/CI time, not checked in
trace-tools/
cities/*/trace-tools/

# test run artifacts (regenerated each run)
cities/*/traces/runs/
cities/*/traces/specs/generated_*

# Generated build artifacts (uploaded directly to Supabase, archived on 'archive' branch)
cities/*/*.ics
cities/*/combined.ics
cities/*/events.json

# Auto-generated report (regenerate with scripts/snippet_report.py)
docs/snippet-report.md
cli/cc-cli

# Generated at build/commit time — always diverges across forks.
# Anchored to the root: the per-city slices under report/<city>/ ARE
# committed (the workflow's git add report/ publishes them to Pages).
/report.json
xmlui/version.txt

# Bram / Claude Code machine-local state (Setup-managed, never committed;
# CLAUDE.md above is the same class)
.claude/
resources/
xmlui/.claude/
xmlui/resources/

# Local audit runner outputs (regenerate with scripts/local_build.py)
local-build-report.json
local-build.log
local-feed-report.json
local-validation-report.json

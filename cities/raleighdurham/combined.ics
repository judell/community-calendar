BEGIN:VEVENT
X-SOURCE-URLS:{"Gardens": "https://gardens.duke.edu/event/midday-meander-11/"}
X-SOURCE-ID:gardens
X-SOURCE:Sarah P. Duke Gardens
DTSTART;TZID=America/New_York:20260916T121500
DTEND;TZID=America/New_York:20260916T130000

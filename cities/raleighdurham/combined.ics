BEGIN:VEVENT
X-SOURCE-ID:gcal_41d85e1478a55e3b4adbf2e4951c5be9f6e49241ac55a65427c71d252849bf1c
SUMMARY:Defend Democracy Saturdays: Downtown Durham
DTSTART;TZID=America/New_York:20261128T100000

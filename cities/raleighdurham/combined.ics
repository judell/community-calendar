X-SOURCE-URLS:{"Ncwf": "https://ncwf.org/event/the-afterlife-of-trees-davidson/"}
X-SOURCE-ID:ncwf
X-SOURCE:NC Wildlife Federation
DTSTART;TZID=America/New_York:20261018T090000
DTEND;TZID=America/New_York:20261018T130000

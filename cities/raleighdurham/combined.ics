X-SOURCE-URLS:{"Downtowndurham": "https://downtowndurham.com/event/jim-mckeon-durham-sweet-durham/2026-10-03/"}
X-SOURCE-ID:downtowndurham
X-SOURCE:Downtown Durham Inc
DTSTART;TZID=America/New_York:20261003T130000

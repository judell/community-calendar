SUMMARY:Team ENOUGH Welcome Session (For Young People Under 26)
DTSTART;TZID=America/New_York:20261202T180000
DTEND;TZID=America/New_York:20261202T190000
DTSTAMP:20261121T065002Z
UID:7pfc36pdp594po9lgrhc684mr5@google.com
RECURRENCE-ID;TZID=America/New_York:20261202T180000
SEQUENCE:0

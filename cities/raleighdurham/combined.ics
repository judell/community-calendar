X-SOURCE-ID:gcal_lgbtqcenterofdurham_org_qb71v8n48d0a304sq7dtm89f84
SUMMARY:2026 Trans Day of Remembrance "Trancestors Kiki Ball"
DTSTART;TZID=America/New_York:20261120T180000
DTEND;TZID=America/New_York:20261121T010000
DTSTAMP:20261114T061542Z
UID:3ng3eotnaprbqdlc4r6siqbjie@google.com

<style id="jj-related-posts-inline-css">

		.jj-related-posts {
			width: 100%;
		}

		.jj-related-posts__heading {
			margin: 0 0 30px;
		}

		.jj-related-posts__grid {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 30px;
		}

		.jj-related-posts__card {
			position: relative;
			min-width: 0;
			margin: 0;
			overflow: hidden;
			border-radius: 4px;
			background-color: #333;
		}

		.jj-related-posts__link {
			position: relative;
			display: block;
			aspect-ratio: 1.8 / 1;
			overflow: hidden;
			color: #fff;
			text-decoration: none;
			transition: opacity .45s cubic-bezier(.15, .75, .5, 1) 0s, transform 1s ease;
		}

		.jj-related-posts__image {
			position: absolute;
			inset: 0;
			display: block;
			width: 100%;
			height: 100%;
			object-fit: cover;
			transition: opacity .45s cubic-bezier(.15, .75, .5, 1) 0s, transform 1s ease;
		}

		.jj-related-posts__image--placeholder {
			background-color: #4a4a4a;
		}

		.jj-related-posts__overlay {
			position: absolute;
			inset: 0;
			z-index: 1;
			background:
				linear-gradient(
					to top,
					rgba(0, 0, 0, 0.72) 0%,
					rgba(0, 0, 0, 0.32) 55%,
					rgba(0, 0, 0, 0.05) 100%
				);
			transition: background-color 0.3s ease;
		}

		.jj-related-posts__title {
			position: absolute;
			right: 8%;
			bottom: 10%;
			left: 8%;
			z-index: 2;
			display: block;
			margin: 0;
			color: #fff;
			    line-height: 1.25;
    text-wrap: balance;
    font-size: 1.5rem !important;
    letter-spacing: -1px;
    font-weight: 500;
    font-family: myriad-pro,sans-serif;
		}
		img.jj-related-posts__image.lazyloaded {
    transition: opacity .45s cubic-bezier(.15, .75, .5, 1) 0s, transform 1s ease;
        min-height: 34vh;
}

		.jj-related-posts__link:hover,
		.jj-related-posts__link:focus {
			color: #fff;
			text-decoration: none;
		}

		.jj-related-posts__link:hover .jj-related-posts__image,
		.jj-related-posts__link:focus .jj-related-posts__image {
			transform: scale(1.1);
			transition: opacity .45s cubic-bezier(.15, .75, .5, 1) 0s, transform 1s ease;
		}

		.jj-related-posts__link:focus-visible {
			outline: 3px solid currentColor;
			outline-offset: -6px;
		}

		@media only screen and (max-width: 767px) {
			.jj-related-posts__grid {
				grid-template-columns: 1fr;
				gap: 20px;
			}

			.jj-related-posts__link {
				aspect-ratio: 1.25 / 1;
			}

			.jj-related-posts__title {
				font-size: clamp(25px, 8vw, 36px);
			}
		}
	
/*# sourceURL=jj-related-posts-inline-css */
</style>

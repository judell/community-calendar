            <script type="application/ld+json">
            {
                "@context": "http://schema.org",
                "@type": "Event",
                "eventStatus": "https://schema.org/EventScheduled",
                "startDate": "2026-11-12T07:00:00-05:00",
                "endDate": "2026-11-12T08:30:00-05:00",
                "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
                "location":
                {
                    "@type": "Place",
                                        "name": "Virtual",
                    "image": "",
                    "address": ""
                                    },
                                "organizer":
                {
                    "@type": "Person",
                    "name": "Transitions GriefCare",
                    "url": "https://transitionslifecare.org/care-services/grief-care/"
                },

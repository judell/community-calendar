<script></script>	<script id="mbb-social-sharing-script">
		document.addEventListener('DOMContentLoaded', function () {
			const socialSharing = document.querySelector('.mbb-social-sharing');
			if (!socialSharing) return;

			document.body.appendChild(socialSharing);
			socialSharing.classList.add('mbb-social-sharing--ready');

			const copyButton = socialSharing.querySelector('[data-mbb-copy-link]');
			if (!copyButton) return;

			const status = socialSharing.querySelector('.mbb-social-sharing__status');
			const confirmation = socialSharing.querySelector('.mbb-social-sharing__copy-confirmation');
			let confirmationTimer;
			const url = socialSharing.getAttribute('data-share-url') || window.location.href;

			function showCopied() {
				const originalTitle = 'Copy link';
				copyButton.setAttribute('title', 'Link copied!');
				copyButton.setAttribute('aria-label', 'Link copied!');
				if (status) status.textContent = 'Link copied to clipboard.';
				if (confirmation) {
					window.clearTimeout(confirmationTimer);
					confirmation.classList.add('is-visible');
					confirmation.setAttribute('aria-hidden', 'false');
				}

				confirmationTimer = window.setTimeout(function () {
					copyButton.setAttribute('title', originalTitle);
					copyButton.setAttribute('aria-label', originalTitle);
					if (status) status.textContent = '';
					if (confirmation) {
						confirmation.classList.remove('is-visible');
						confirmation.setAttribute('aria-hidden', 'true');
					}
				}, 2000);
			}

			function fallbackCopy(text) {
				const textarea = document.createElement('textarea');
				textarea.value = text;
				textarea.setAttribute('readonly', '');
				textarea.style.position = 'fixed';
				textarea.style.opacity = '0';
				document.body.appendChild(textarea);
				textarea.select();
				let copied = false;
				try { copied = document.execCommand('copy'); } catch (e) { copied = false; }
				document.body.removeChild(textarea);
				return copied;
			}

			copyButton.addEventListener('click', function () {
				if (navigator.clipboard && window.isSecureContext) {
					navigator.clipboard.writeText(url).then(showCopied).catch(function () {
						if (fallbackCopy(url)) showCopied();
					});
				} else if (fallbackCopy(url)) {
					showCopied();
				}
			});
		});
	</script>
	
	<script>
	(function() {
		const menuData = [{"location":"top_nav","navClass":"primary-menu","ulClass":"primary-menu--nav"}];

		function addClasses(el, classString) {
			if (!el || !classString) {
				return;
			}

			classString.split(/\s+/).forEach(function(className) {
				className = className.trim();

				if (className) {
					el.classList.add(className);
				}
			});
		}

		function applyMenuClasses() {
			menuData.forEach(function(menu) {
				/**
				 * Salient desktop main menu.
				 * Matches:
				 * <nav aria-label="Main Menu">
				 */
				const mainNavs = document.querySelectorAll('nav[aria-label="Main Menu"]');

				mainNavs.forEach(function(nav) {
					addClasses(nav, menu.navClass);

					const uls = nav.querySelectorAll('ul.sf-menu');

					uls.forEach(function(ul) {
						addClasses(ul, menu.ulClass);
					});
				});

				/**
				 * Extra fallback:
				 * Add the UL class to any Salient-style menu UL.
				 */
				if (menu.ulClass) {
					const salientMenus = document.querySelectorAll('ul.sf-menu');

					salientMenus.forEach(function(ul) {
						addClasses(ul, menu.ulClass);

						const parentNav = ul.closest('nav');

						if (parentNav) {
							addClasses(parentNav, menu.navClass);
						}
					});
				}
			});
		}

		// Run immediately.
		applyMenuClasses();

		// Run when DOM is ready.
		document.addEventListener('DOMContentLoaded', applyMenuClasses);

		// Run after full page load.
		window.addEventListener('load', function() {
			applyMenuClasses();

			// Salient sometimes adjusts/rebuilds header markup after load.
			setTimeout(applyMenuClasses, 250);
			setTimeout(applyMenuClasses, 750);
			setTimeout(applyMenuClasses, 1500);
			setTimeout(applyMenuClasses, 3000);
		});

		// Watch for late header/menu changes.
		const observer = new MutationObserver(function() {
			applyMenuClasses();
		});

		observer.observe(document.documentElement, {
			childList: true,
			subtree: true
		});
	})();
	</script>

		<style>
		/* Mobile tab toggle is hidden on desktop. */
		.dementia-resources .dementia-tabs-toggle {
			display: none;
		}

		@media only screen and (max-width: 767px) {

			.dementia-resources .wpb_wrapper.tabbed {
				display: block !important;
			}

			/* Mobile toggle button */
			.dementia-resources .dementia-tabs-toggle {
				position: relative;
				display: flex;
				align-items: center;
				justify-content: space-between;
				width: 100%;
				margin: 0;
				padding: 18px 52px 18px 20px;
				border: 0;
				border-radius: 6px;
				background: linear-gradient(
					135deg,
					var(--nectar-extra-color-1, #79a7a9),
					var(--nectar-extra-color-2, #46777a)
				);
				color: #fff;
				font: inherit;
				font-size: 15px;
				font-weight: 700;
				line-height: 1.35;
				text-align: left;
				cursor: pointer;
				appearance: none;
				-webkit-appearance: none;
				margin-top: -3vh;
				margin-bottom: 3vh;
			}

			/* Arrow */
			.dementia-resources .dementia-tabs-toggle::after {
				content: "";
				position: absolute;
				top: 50%;
				right: 21px;
				width: 10px;
				height: 10px;
				border-right: 2px solid currentColor;
				border-bottom: 2px solid currentColor;
				transform: translateY(-70%) rotate(45deg);
				transition: transform 0.25s ease;
			}

			.dementia-resources .dementia-tabs-toggle[aria-expanded="true"]::after {
				transform: translateY(-25%) rotate(225deg);
			}

			.dementia-resources .dementia-tabs-toggle:focus-visible {
				outline: 3px solid currentColor;
				outline-offset: 3px;
			}

			/*
			 * Override Salient's vertical tab navigation
			 * and hide it until the toggle is opened.
			 */
			.dementia-resources .wpb_tabs_nav {
				display: none !important;
				position: relative;
				width: 100% !important;
				margin: 8px 0 25px !important;
				padding: 8px !important;
				border-radius: 6px;
				background: #f1f1f1;
				box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
			}

			.dementia-resources.mobile-tabs-open .wpb_tabs_nav {
				display: block !important;
				margin-top: -25px !important;
			}

			/* Stack the tab options vertically */
			.dementia-resources .wpb_tabs_nav > li.tab-item {
				display: block !important;
				float: none !important;
				width: 100% !important;
				margin: 0 !important;
				padding: 0 !important;
			}

			.dementia-resources .wpb_tabs_nav > li.tab-item > a {
				display: block !important;
				width: 100% !important;
				padding: 14px 15px !important;
				border: 0 !important;
				border-radius: 4px !important;
				background: transparent !important;
				color: #5d5fa4 !important;
				font-size: 16px !important;
				font-weight: 600 !important;
				line-height: 1.35 !important;
				text-align: left !important;
			}

			.dementia-resources .wpb_tabs_nav > li.tab-item > a:hover,
			.dementia-resources .wpb_tabs_nav > li.tab-item > a:focus {
				background: rgba(93, 95, 164, 0.1) !important;
			}

			.dementia-resources .wpb_tabs_nav > li.active-tab > a {
				background: #fff !important;
				box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
			}

			/*
			 * Ensure the tab content occupies the full width.
			 * Salient normally reserves space for the vertical nav.
			 */
			.dementia-resources .wpb_tab {
				width: 100% !important;
				margin-left: 0 !important;
				padding-left: 0 !important;
			}
		}
	</style>

	<script>
		document.addEventListener('DOMContentLoaded', function () {
			const mobileBreakpoint = window.matchMedia('(max-width: 767px)');
			const tabGroups = document.querySelectorAll('.dementia-resources');

			tabGroups.forEach(function (tabGroup, groupIndex) {
				const tabNav = tabGroup.querySelector('.wpb_tabs_nav');

				if (!tabNav || tabGroup.querySelector('.dementia-tabs-toggle')) {
					return;
				}

				const tabLinks = tabNav.querySelectorAll('li.tab-item > a');

				if (!tabLinks.length) {
					return;
				}

				const navId = 'dementia-tabs-nav-' + groupIndex;
				tabNav.id = navId;

				const toggle = document.createElement('button');
				toggle.type = 'button';
				toggle.className = 'dementia-tabs-toggle';
				toggle.setAttribute('aria-expanded', 'false');
				toggle.setAttribute('aria-controls', navId);

				function getActiveTabText() {
					const activeLink = tabNav.querySelector(
						'li.active-tab > a, li.ui-tabs-active > a'
					);

					return activeLink
						? activeLink.textContent.trim()
						: tabLinks[0].textContent.trim();
				}

				function updateToggleText() {
					toggle.textContent = getActiveTabText();
				}

				function closeMobileMenu() {
					tabGroup.classList.remove('mobile-tabs-open');
					toggle.setAttribute('aria-expanded', 'false');
				}

				function openMobileMenu() {
					tabGroup.classList.add('mobile-tabs-open');
					toggle.setAttribute('aria-expanded', 'true');
				}

				updateToggleText();
				tabNav.parentNode.insertBefore(toggle, tabNav);

				toggle.addEventListener('click', function () {
					const isOpen = tabGroup.classList.contains('mobile-tabs-open');

					if (isOpen) {
						closeMobileMenu();
					} else {
						openMobileMenu();
					}
				});

				tabLinks.forEach(function (link) {
					link.addEventListener('click', function () {
						/*
						 * Let Salient switch the actual tab first,
						 * then update and close the mobile navigation.
						 */
						window.setTimeout(function () {
							toggle.textContent = link.textContent.trim();

							if (mobileBreakpoint.matches) {
								closeMobileMenu();

								/*
								 * Bring the selected tab content back into view
								 * without jumping all the way to the page top.
								 */
								tabGroup.scrollIntoView({
									behavior: 'smooth',
									block: 'start'
								});
							}
						}, 50);
					});
				});

				/*
				 * Close the menu when clicking outside the tabs.
				 */
				document.addEventListener('click', function (event) {
					if (
						mobileBreakpoint.matches &&
						!tabGroup.contains(event.target)
					) {
						closeMobileMenu();
					}
				});

				/*
				 * Close with the Escape key.
				 */
				tabGroup.addEventListener('keydown', function (event) {
					if (
						event.key === 'Escape' &&
						tabGroup.classList.contains('mobile-tabs-open')
					) {
						closeMobileMenu();
						toggle.focus();
					}
				});

				/*
				 * Reset the mobile state when returning to desktop.
				 */
				mobileBreakpoint.addEventListener('change', function (event) {
					if (!event.matches) {
						closeMobileMenu();
						updateToggleText();
					}
				});
			});
		});
	</script>
		<style id="mbb-mobile-scrolling-tabs-dropdown-styles">

		.mbb-mobile-tab-dropdown,
		.mbb-mobile-tab-dropdown-placeholder {
			display: none;
		}

		@media only screen and (max-width: 999px) {

			/* Hide original Salient vertical navigation */
			.nectar-scrolling-tabs .scrolling-tab-nav {
				display: none !important;
			}

			/*
			 * Placeholder marks the dropdown's original location.
			 */
			.mbb-mobile-tab-dropdown-placeholder {
				display: block;
				width: 100%;
				height: 0;
				margin: 0;
				padding: 0;
			}

			.mbb-mobile-tab-dropdown-placeholder.is-active {
				height: var(--mbb-placeholder-height, 0px);
				margin-bottom: 30px;
			}

			/*
			 * Normal dropdown.
			 */
			.mbb-mobile-tab-dropdown {
				display: block;
				position: relative;

				width: 100%;
				margin: 0 0 30px;
				padding: 18px;

				background: #fff;

				border-radius: 3px;

				box-shadow:
					2px 2px 22px rgba(51, 51, 51, 0.25);

				box-sizing: border-box;

				z-index: 100;
			}

			/*
			 * Fixed dropdown.
			 *
			 * JS moves this directly into <body>.
			 */
			body > .mbb-mobile-tab-dropdown.is-fixed {
				position: fixed !important;

				/*top: var(--mbb-fixed-top, 100px) !important;*/
				top: 0px !important;
				left: var(--mbb-fixed-left, 0px) !important;

				width: var(--mbb-fixed-width, 100%) !important;

				margin: 0 !important;

				z-index: 999 !important;

				transform: none !important;
			}

			/*
			 * Label
			 */
			.mbb-mobile-tab-dropdown__label {
				display: block;

				margin: 0 0 7px;

				color: gray;

				font-size: 14px;
				font-weight: 600;
				line-height: 1.3;
			}

			/*
			 * Main button
			 */
			.mbb-mobile-tab-dropdown__button {
				display: flex;

				align-items: center;
				justify-content: space-between;

				width: 100%;
				min-height: 52px;

				margin: 0;
				padding: 12px 16px;

				color: #333;

				font-family: inherit;
				font-size: 13px;
				font-weight: 600;
				line-height: 1.3;

				text-align: left;

				background: #fff;

				border: 1px solid #8684B2;
				border-radius: 4px;

				box-sizing: border-box;

				cursor: pointer;
			}

			.mbb-mobile-tab-dropdown__button:hover {
				border-color: #6865A5;
			}

			.mbb-mobile-tab-dropdown__button:focus-visible {
				border-color: #6865A5;

				outline: 3px solid rgba(104, 101, 165, 0.22);
				outline-offset: 2px;
			}

			/*
			 * Arrow
			 */
			.mbb-mobile-tab-dropdown__arrow {
				flex: 0 0 auto;

				width: 9px;
				height: 9px;

				margin-left: 15px;

				border-right: 2px solid #6865A5;
				border-bottom: 2px solid #6865A5;

				transform:
					rotate(45deg)
					translateY(-2px);

				transition:
					transform 0.2s ease;
			}

			.mbb-mobile-tab-dropdown.is-open
			.mbb-mobile-tab-dropdown__arrow {
				transform:
					rotate(225deg)
					translate(-2px, -2px);
			}

			/*
			 * Dropdown menu
			 */
			.mbb-mobile-tab-dropdown__menu {
				display: none;

				position: absolute;

				top: calc(100% - 18px);
				right: 10px;
				left: 10px;

				z-index: 1000000;

				margin: 0;
				padding: 6px;

				background: #fff;

				border:
					1px solid
					rgba(104, 101, 165, 0.28);

				border-radius:
					0 0 6px 6px;

				box-shadow:
					0 10px 24px
					rgba(0, 0, 0, 0.16);

				list-style: none;
			}

			.mbb-mobile-tab-dropdown.is-open
			.mbb-mobile-tab-dropdown__menu {
				display: block;
			}

			.mbb-mobile-tab-dropdown__menu-item {
				margin: 0;
				padding: 0;
				list-style: none;
			}

			/*
			 * Menu options
			 */
			.mbb-mobile-tab-dropdown__option {
				display: block;

				width: 100%;

				margin: 0;
				padding: 12px 14px;

				color: #333;

				font-family: inherit;
				font-size: 15px;
				font-weight: 500;
				line-height: 1.35;

				text-align: left;

				background: transparent;

				border: 0;
				border-radius: 3px;

				cursor: pointer;
			}

			.mbb-mobile-tab-dropdown__option:hover,
			.mbb-mobile-tab-dropdown__option:focus-visible {
				color: #333;
				background: #E1ECEC;
				outline: none;
			}

			.mbb-mobile-tab-dropdown__option.is-active {
				color: #fff;
				background: #6865A5;
			}

		}

	</style>

	<script>
	(function () {

		'use strict';


		const mobileBreakpoint = 999;


		/**
		 * Get the bottom edge of the actual Salient header.
		 *
		 * This is better than assuming a fixed 80px/100px
		 * header height.
		 */
		function getHeaderBottom() {

			const header =
				document.querySelector('#header-outer');


			if (header) {

				const rect =
					header.getBoundingClientRect();


				/*
				 * If header is currently visible/fixed at top,
				 * use its real bottom edge.
				 */
				if (
					rect.bottom > 0 &&
					rect.top < window.innerHeight
				) {

					return Math.max(
						0,
						rect.bottom
					);

				}

			}


			/*
			 * Fallback for this site's mobile header.
			 */
			return 100;

		}


		/**
		 * Initialize.
		 */
		function initializeMobileTabDropdowns() {

			document
				.querySelectorAll(
					'.nectar-scrolling-tabs'
				)
				.forEach(
					function (
						tabs,
						tabsIndex
					) {

						if (
							tabs.dataset
								.mbbMobileDropdownInitialized ===
							'true'
						) {
							return;
						}


						const nav =
							tabs.querySelector(
								'.scrolling-tab-nav'
							);


						const contentWrapper =
							tabs.querySelector(
								'.scrolling-tab-content'
							);


						if (
							!nav ||
							!contentWrapper
						) {
							return;
						}


						const menuItems =
							Array.from(
								nav.querySelectorAll(
									'.wpb_tabs_nav > .menu-item'
								)
							);


						let tabPanels =
							Array.from(
								contentWrapper.querySelectorAll(
									'[id^="tab_"]'
								)
							);


						/*
						 * Remove duplicate IDs.
						 */
						tabPanels =
							tabPanels.filter(
								function (
									panel,
									index,
									panels
								) {

									return (
										panels.findIndex(
											function (
												candidate
											) {

												return (
													candidate.id ===
													panel.id
												);

											}
										) ===
										index
									);

								}
							);


						if (
							!menuItems.length ||
							!tabPanels.length
						) {
							return;
						}


						tabs.dataset
							.mbbMobileDropdownInitialized =
							'true';


						/*
						 * Placeholder.
						 */
						const placeholder =
							document.createElement(
								'div'
							);


						placeholder.className =
							'mbb-mobile-tab-dropdown-placeholder';


						/*
						 * Wrapper.
						 */
						const wrapper =
							document.createElement(
								'div'
							);


						wrapper.className =
							'mbb-mobile-tab-dropdown';


						/*
						 * Label.
						 */
						const label =
							document.createElement(
								'span'
							);


						label.className =
							'mbb-mobile-tab-dropdown__label';


						label.textContent =
							'Jump To A Section';


						/*
						 * Button.
						 */
						const button =
							document.createElement(
								'button'
							);


						button.type =
							'button';


						button.className =
							'mbb-mobile-tab-dropdown__button';


						button.id =
							'mbb-mobile-tab-dropdown-button-' +
							tabsIndex;


						button.setAttribute(
							'aria-haspopup',
							'listbox'
						);


						button.setAttribute(
							'aria-expanded',
							'false'
						);


						const buttonText =
							document.createElement(
								'span'
							);


						buttonText.className =
							'mbb-mobile-tab-dropdown__button-text';


						const arrow =
							document.createElement(
								'span'
							);


						arrow.className =
							'mbb-mobile-tab-dropdown__arrow';


						arrow.setAttribute(
							'aria-hidden',
							'true'
						);


						button.appendChild(
							buttonText
						);


						button.appendChild(
							arrow
						);


						/*
						 * Menu.
						 */
						const menu =
							document.createElement(
								'ul'
							);


						menu.className =
							'mbb-mobile-tab-dropdown__menu';


						menu.id =
							'mbb-mobile-tab-dropdown-menu-' +
							tabsIndex;


						menu.setAttribute(
							'role',
							'listbox'
						);


						button.setAttribute(
							'aria-controls',
							menu.id
						);


						const options = [];


						/*
						 * Build options from Salient navigation.
						 */
						menuItems.forEach(
							function (
								menuItem,
								itemIndex
							) {

								const panel =
									tabPanels[
										itemIndex
									];


								if (!panel) {
									return;
								}


								const heading =
									menuItem.querySelector(
										'.tab-nav-heading,' +
										'.menu-content h1,' +
										'.menu-content h2,' +
										'.menu-content h3,' +
										'.menu-content'
									);


								const itemText =
									heading
										? heading
											.textContent
											.trim()
										: menuItem
											.textContent
											.trim();


								const listItem =
									document.createElement(
										'li'
									);


								listItem.className =
									'mbb-mobile-tab-dropdown__menu-item';


								listItem.setAttribute(
									'role',
									'presentation'
								);


								const option =
									document.createElement(
										'button'
									);


								option.type =
									'button';


								option.className =
									'mbb-mobile-tab-dropdown__option';


								option.dataset.panelId =
									panel.id;


								option.textContent =
									itemText;


								option.setAttribute(
									'role',
									'option'
								);


								option.setAttribute(
									'aria-selected',
									itemIndex === 0
										? 'true'
										: 'false'
								);


								listItem.appendChild(
									option
								);


								menu.appendChild(
									listItem
								);


								options.push(
									option
								);

							}
						);


						if (!options.length) {
							return;
						}


						buttonText.textContent =
							options[0].textContent;


						options[0].classList.add(
							'is-active'
						);


						wrapper.appendChild(
							label
						);


						wrapper.appendChild(
							button
						);


						wrapper.appendChild(
							menu
						);


						/*
						 * Insert placeholder and wrapper.
						 */
						tabs.insertBefore(
							placeholder,
							contentWrapper
						);


						tabs.insertBefore(
							wrapper,
							contentWrapper
						);


						/**
						 * Put dropdown back in its
						 * original location.
						 */
						function restoreWrapper() {

							if (
								wrapper.parentNode !==
								tabs
							) {

								tabs.insertBefore(
									wrapper,
									contentWrapper
								);

							}


							wrapper.classList.remove(
								'is-fixed'
							);


							placeholder.classList.remove(
								'is-active'
							);


							wrapper.style.removeProperty(
								'--mbb-fixed-top'
							);


							wrapper.style.removeProperty(
								'--mbb-fixed-left'
							);


							wrapper.style.removeProperty(
								'--mbb-fixed-width'
							);

						}


						/**
						 * Move wrapper to BODY and fix it.
						 */
						function fixWrapper(
							top,
							left,
							width,
							height
						) {

							placeholder.classList.add(
								'is-active'
							);


							placeholder.style.setProperty(
								'--mbb-placeholder-height',
								height + 'px'
							);


							/*
							 * Critical part:
							 * escape all Salient parents.
							 */
							if (
								wrapper.parentNode !==
								document.body
							) {

								document.body.appendChild(
									wrapper
								);

							}


							wrapper.style.setProperty(
								'--mbb-fixed-top',
								top + 'px'
							);


							wrapper.style.setProperty(
								'--mbb-fixed-left',
								left + 'px'
							);


							wrapper.style.setProperty(
								'--mbb-fixed-width',
								width + 'px'
							);


							wrapper.classList.add(
								'is-fixed'
							);

						}


						/**
						 * Open.
						 */
						function openMenu() {

							wrapper.classList.add(
								'is-open'
							);


							button.setAttribute(
								'aria-expanded',
								'true'
							);

						}


						/**
						 * Close.
						 */
						function closeMenu() {

							wrapper.classList.remove(
								'is-open'
							);


							button.setAttribute(
								'aria-expanded',
								'false'
							);

						}


						function toggleMenu() {

							if (
								wrapper.classList.contains(
									'is-open'
								)
							) {

								closeMenu();

							} else {

								openMenu();

							}

						}


						/**
						 * Update active option.
						 */
						function setActiveOption(
							panelId
						) {

							options.forEach(
								function (
									option
								) {

									const isActive =
										option.dataset
											.panelId ===
										panelId;


									option.classList.toggle(
										'is-active',
										isActive
									);


									option.setAttribute(
										'aria-selected',
										isActive
											? 'true'
											: 'false'
									);


									if (isActive) {

										buttonText.textContent =
											option.textContent;

									}

								}
							);

						}


						/**
						 * Scroll to section.
						 */
						function scrollToPanel(
							panelId
						) {

							const target =
								document.getElementById(
									panelId
								);


							if (!target) {
								return;
							}


							setActiveOption(
								panelId
							);


							closeMenu();


							const currentScroll =
								window.pageYOffset ||
								document.documentElement
									.scrollTop ||
								0;


							const headerBottom =
								getHeaderBottom();


							const dropdownHeight =
								wrapper.offsetHeight;


							const targetTop =
								target
									.getBoundingClientRect()
									.top +
								currentScroll -
								headerBottom -
								dropdownHeight -
								20;


							window.history.replaceState(
								null,
								'',
								'#' + panelId
							);


							window.scrollTo({
								top: Math.max(
									0,
									targetTop
								),
								behavior: 'smooth'
							});

						}


						/**
						 * Track active section.
						 */
						function updateSelectedOption() {

							if (
								window.innerWidth >
								mobileBreakpoint
							) {
								return;
							}


							const referenceLine =
								getHeaderBottom() +
								wrapper.offsetHeight +
								30;


							let activePanel =
								tabPanels[0];


							tabPanels.forEach(
								function (
									panel
								) {

									if (
										panel
											.getBoundingClientRect()
											.top <=
										referenceLine
									) {

										activePanel =
											panel;

									}

								}
							);


							if (activePanel) {

								setActiveOption(
									activePanel.id
								);

							}

						}


						/**
						 * Main fixed-position logic.
						 */
						function updateFixedPosition() {

							if (
								window.innerWidth >
								mobileBreakpoint
							) {

								restoreWrapper();
								return;

							}


							const headerBottom =
								getHeaderBottom();


							/*
							 * Placeholder always stays in
							 * original tab container, so it
							 * gives us a reliable trigger point.
							 */
							const placeholderRect =
								placeholder
									.getBoundingClientRect();


							const tabsRect =
								tabs
									.getBoundingClientRect();


							const wrapperHeight =
								wrapper.offsetHeight;


							/*
							 * Width/left should match the
							 * original content column.
							 */
							const availableWidth =
								placeholderRect.width;


							const availableLeft =
								placeholderRect.left;


							/*
							 * Start sticking after original
							 * dropdown reaches the header.
							 *
							 * Stop at end of tabs container.
							 */
							const shouldFix =
								placeholderRect.top <=
									headerBottom &&
								tabsRect.bottom >
									headerBottom +
									wrapperHeight +
									20;


							if (shouldFix) {

								fixWrapper(
									headerBottom,
									availableLeft,
									availableWidth,
									wrapperHeight
								);

							} else {

								restoreWrapper();

							}

						}


						/*
						 * Button.
						 */
						button.addEventListener(
							'click',
							function (event) {

								event.preventDefault();
								event.stopPropagation();

								toggleMenu();

							}
						);


						/*
						 * Options.
						 */
						options.forEach(
							function (
								option
							) {

								option.addEventListener(
									'click',
									function (
										event
									) {

										event.preventDefault();
										event.stopPropagation();


										scrollToPanel(
											option.dataset
												.panelId
										);

									}
								);

							}
						);


						/*
						 * Click outside.
						 */
						document.addEventListener(
							'click',
							function (
								event
							) {

								if (
									!wrapper.contains(
										event.target
									)
								) {

									closeMenu();

								}

							}
						);


						/*
						 * Escape.
						 */
						document.addEventListener(
							'keydown',
							function (
								event
							) {

								if (
									event.key ===
									'Escape'
								) {

									closeMenu();

								}

							}
						);


						/*
						 * Throttled updates.
						 */
						let ticking =
							false;


						function requestUpdate() {

							if (ticking) {
								return;
							}


							ticking =
								true;


							window.requestAnimationFrame(
								function () {

									updateFixedPosition();
									updateSelectedOption();

									ticking =
										false;

								}
							);

						}


						window.addEventListener(
							'scroll',
							requestUpdate,
							{
								passive: true
							}
						);


						window.addEventListener(
							'resize',
							requestUpdate
						);


						requestUpdate();

					}
				);

		}


		if (
			document.readyState ===
			'loading'
		) {

			document.addEventListener(
				'DOMContentLoaded',
				initializeMobileTabDropdowns
			);

		} else {

			initializeMobileTabDropdowns();

		}


		window.addEventListener(
			'load',
			initializeMobileTabDropdowns
		);


		window.setTimeout(
			initializeMobileTabDropdowns,
			500
		);


		window.setTimeout(
			initializeMobileTabDropdowns,
			1500
		);


		window.setTimeout(
			initializeMobileTabDropdowns,
			3000
		);

	})();
	</script>
	
<script>
jQuery(document).ready(function()
{
    var mec_interval = setInterval(function()
    {
        // Not Visible
        if(!jQuery("#mec_skin_mec1").is(":visible")) return;
        
        jQuery("#mec_skin_mec1").mecFullCalendar(
        {
            id: "mec1",
            atts: "atts%5Bsk-options%5D%5Bmonthly_view%5D%5Bstyle%5D=classic&atts%5Bsk-options%5D%5Bfull_calendar%5D%5Bstyle%5D=classic&atts%5Bsk-options%5D%5Byearly_view%5D%5Bstyle%5D=modern&atts%5Bsk-options%5D%5Bweekly_view%5D%5Bstyle%5D=classic&atts%5Bsk-options%5D%5Bdaily_view%5D%5Bstyle%5D=classic&atts%5Bsk-options%5D%5Btimetable%5D%5Bstyle%5D=modern&atts%5Bsk-options%5D%5Blist%5D%5Bstyle%5D=classic&atts%5Bsk-options%5D%5Bgrid%5D%5Bstyle%5D=classic&atts%5Bsk-options%5D%5Bmap%5D%5Bstyle%5D=classic&atts%5Bshow_past_events%5D=0&atts%5Binstance_id%5D=mec1&atts%5Bid%5D=mec1",
            ajax_url: "https://transitionslifecare.org/wp-admin/admin-ajax.php",
            sed_method: "0",
            image_popup: "0",
            sf:
            {
                container: "#mec_search_form_mec1",
                reset: 0,
                refine: 0,
            },
            skin: "list",
        });
        
        clearInterval(mec_interval);
    }, 500);
});
</script>


<script></script>	<style id="mbb-social-sharing-styles">
		.mbb-social-sharing{position:fixed!important;top:50%;left:auto;right:auto;z-index:99999;background:var(--mbb-share-bg-color,#fff);box-shadow:0 4px 18px rgba(0,0,0,.14);transform:translateY(-50%);overflow:visible;will-change:transform}.mbb-social-sharing--left{left:0!important;border-radius:0 8px 8px 0}.mbb-social-sharing--right{right:0!important;border-radius:8px 0 0 8px}.mbb-social-sharing--style-bar .mbb-social-sharing__list{overflow:hidden;border-radius:inherit}.mbb-social-sharing__list{display:flex;flex-direction:column;gap:0;margin:0;padding:0;list-style:none}.mbb-social-sharing__item{margin:0;padding:0;list-style:none}.mbb-social-sharing__link{appearance:none;-webkit-appearance:none;display:flex;align-items:center;justify-content:center;width:50px;height:50px;padding:0;color:var(--mbb-share-icon-color,#615E97);background:var(--mbb-share-bg-color,#fff);font:inherit;text-decoration:none;border:0;border-bottom:1px solid rgba(0,0,0,.08);border-radius:0;cursor:pointer;transition:color .2s ease,background-color .2s ease,transform .2s ease,box-shadow .2s ease}.mbb-social-sharing__item:last-child .mbb-social-sharing__link{border-bottom:0}.mbb-social-sharing__link:hover,.mbb-social-sharing__link:focus-visible{color:var(--mbb-share-icon-hover-color,#447A7C);background-color:var(--mbb-share-bg-hover-color,#E1ECEC);text-decoration:none;transform:translateX(2px)}.mbb-social-sharing--right .mbb-social-sharing__link:hover,.mbb-social-sharing--right .mbb-social-sharing__link:focus-visible{transform:translateX(-2px)}.mbb-social-sharing__link:focus-visible{position:relative;z-index:2;outline:3px solid currentColor;outline-offset:-3px}.mbb-social-sharing__icon{display:block;width:21px;height:21px;fill:currentColor}.mbb-social-sharing--style-buttons,.mbb-social-sharing--style-circles{background:transparent;box-shadow:none;overflow:visible;border-radius:0}.mbb-social-sharing--style-buttons .mbb-social-sharing__list,.mbb-social-sharing--style-circles .mbb-social-sharing__list{gap:8px}.mbb-social-sharing--style-buttons .mbb-social-sharing__link,.mbb-social-sharing--style-circles .mbb-social-sharing__link{border:0;box-shadow:0 4px 14px rgba(0,0,0,.14)}.mbb-social-sharing--style-buttons .mbb-social-sharing__link{border-radius:8px}.mbb-social-sharing--style-circles .mbb-social-sharing__link{border-radius:50%}.mbb-social-sharing--style-buttons .mbb-social-sharing__link:hover,.mbb-social-sharing--style-buttons .mbb-social-sharing__link:focus-visible,.mbb-social-sharing--style-circles .mbb-social-sharing__link:hover,.mbb-social-sharing--style-circles .mbb-social-sharing__link:focus-visible{box-shadow:0 6px 18px rgba(0,0,0,.18)}.mbb-social-sharing__copy-confirmation{position:absolute;top:50%;left:calc(100% + 10px);padding:7px 10px;background:#222;color:#fff;font-size:13px;line-height:1.2;font-weight:600;white-space:nowrap;border-radius:5px;box-shadow:0 4px 12px rgba(0,0,0,.18);opacity:0;visibility:hidden;pointer-events:none;transform:translateY(-50%) translateX(-4px);transition:opacity .18s ease,transform .18s ease,visibility .18s ease;z-index:3}.mbb-social-sharing--right .mbb-social-sharing__copy-confirmation{left:auto;right:calc(100% + 10px);transform:translateY(-50%) translateX(4px)}.mbb-social-sharing__copy-confirmation.is-visible{opacity:1;visibility:visible;transform:translateY(-50%) translateX(0)}.mbb-social-sharing .screen-reader-text{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);clip-path:inset(50%);white-space:nowrap;border:0}@media only screen and (max-width:690px){.mbb-social-sharing,.mbb-social-sharing--left,.mbb-social-sharing--right{top:auto;right:auto!important;bottom:16px;left:50%!important;transform:translateX(-50%)}.mbb-social-sharing--style-bar{border-radius:8px}.mbb-social-sharing__list{flex-direction:row}.mbb-social-sharing__link{width:48px;height:48px;border-right:1px solid rgba(0,0,0,.08);border-bottom:0}.mbb-social-sharing__item:last-child .mbb-social-sharing__link{border-right:0}.mbb-social-sharing--style-buttons .mbb-social-sharing__link,.mbb-social-sharing--style-circles .mbb-social-sharing__link{border-right:0}.mbb-social-sharing__link:hover,.mbb-social-sharing__link:focus-visible,.mbb-social-sharing--right .mbb-social-sharing__link:hover,.mbb-social-sharing--right .mbb-social-sharing__link:focus-visible{transform:translateY(-2px)}.mbb-social-sharing__copy-confirmation,.mbb-social-sharing--right .mbb-social-sharing__copy-confirmation{top:auto;right:auto;bottom:calc(100% + 10px);left:50%;transform:translateX(-50%) translateY(4px)}.mbb-social-sharing__copy-confirmation.is-visible,.mbb-social-sharing--right .mbb-social-sharing__copy-confirmation.is-visible{transform:translateX(-50%) translateY(0)}}
	</style>
			<script>

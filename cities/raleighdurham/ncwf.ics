		<script type="application/ld+json">
[{"@context":"http://schema.org","@type":"Event","name":"Bat Discovery Program (Swannanoa)","description":"&lt;p&gt;Please join Swannanoa Valley WILD! for a special Bat Discovery Program at Warren Wilson College with Wildlife Biologist Scott Fletcher. Did you know North Carolina is home to at least 17 different species of bats? Often overlooked due to their nocturnal nature, these amazing ecosystem warriors will be out and about during the waxing moon.&hellip;&lt;/p&gt;\\n","image":"https://ncwf.org/wp-content/uploads/batty.jpg","url":"https://ncwf.org/event/bat-discovery-program-swannanoa/","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","eventStatus":"https://schema.org/EventScheduled","startDate":"2026-07-23T19:00:00-04:00","endDate":"2026-07-23T22:30:00-04:00","organizer":{"@type":"Person","name":"NCWF Swannanoa Valley WILD! Chapter","description":"","url":"","telephone":"","email":"","sameAs":""},"performer":"Organization"},{"@context":"http://schema.org","@type":"Event","name":"Brumley Oasis Watering Workday (Chapel Hill)","description":"&lt;p&gt;Join NCWF Tri-County Conservationists Chapter for an oasis maintenance workday! The chapter worked hard to plant and fence 8 native plant oases in Brumley Preserve South. Now comes the important work of stewarding and maintaining the native saplings in these oases. Join us to water these saplings and help them through the drought! REGISTER HERE&lt;/p&gt;\\n","url":"https://ncwf.org/event/brumley-oasis-watering-workday-chapel-hill-2/","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","eventStatus":"https://schema.org/EventScheduled","startDate":"2026-07-24T08:00:00-04:00","endDate":"2026-07-24T10:00:00-04:00","organizer":{"@type":"Person","name":"NCWF TriCounty Conservationists Chapter","description":"","url":"","telephone":"","email":"","sameAs":""},"performer":"Organization"},{"@context":"http://schema.org","@type":"Event","name":"Moth Night (Durham)","description":"&lt;p&gt;NCWF Durham Wildlife Stewards Chapter is thrilled to present its first-ever Moth Night, in conjunction with Backyard Butterflies of Hillsborough. We will learn how to photograph moths and upload the photos to iNaturalist. The photos will eventually become research-grade data for scientists to use. We will circulate around three to four moth light trapping stations&hellip;&lt;/p&gt;\\n","image":"https://ncwf.org/wp-content/uploads/DWSmoths.jpg","url":"https://ncwf.org/event/moth-night-durham/","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","eventStatus":"https://schema.org/EventScheduled","startDate":"2026-07-24T20:00:00-04:00","endDate":"2026-07-24T23:00:00-04:00","organizer":{"@type":"Person","name":"NCWF Durham Wildlife Stewards Chapter","description":"","url":"","telephone":"","email":"","sameAs":""},"performer":"Organization"},{"@context":"http://schema.org","@type":"Event","name":"Moth Night (Carolina Beach)","description":"&lt;p&gt;Join NCWF at Carolina Beach State Park for National Moth Week! Meet some moths you may have never seen before and listen for nocturnal birds in the coastal fringe forest of southeastern NC. Learn to use Seek and iNaturalist to identify and record species sightings. Upload 10 species observations to get your NC Moth Week&hellip;&lt;/p&gt;\\n","image":"https://ncwf.org/wp-content/uploads/mothnightCBSP-1.jpg","url":"https://ncwf.org/event/moth-night-carolina-beach/","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","eventStatus":"https://schema.org/EventScheduled","startDate":"2026-07-24T20:30:00-04:00","endDate":"2026-07-24T22:00:00-04:00","organizer":{"@type":"Person","name":"NCWF","description":"","url":"","telephone":"","email":"","sameAs":""},"performer":"Organization"},{"@context":"http://schema.org","@type":"Event","name":"Moth Night at the Nature Center (Asheville)","description":"&lt;p&gt;Say hi to NCWF ReWild AVL as we celebrate NC Moth Week during a family-friendly evening of discovery at the WNC Nature Center! This event invites you to explore the fascinating world of moths at your own pace while enjoying a variety of interactive activities throughout the evening. Visit lightsheeting stations, where special lights attract&hellip;&lt;/p&gt;\\n","url":"https://ncwf.org/event/moth-night-at-the-nature-center-asheville/","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","eventStatus":"https://schema.org/EventScheduled","startDate":"2026-07-24T20:30:00-04:00","endDate":"2026-07-24T22:30:00-04:00","organizer":{"@type":"Person","name":"NCWF ReWild AVL Chapter","description":"","url":"","telephone":"","email":"","sameAs":""},"performer":"Organization"},{"@context":"http://schema.org","@type":"Event","name":"Moth Night at TAG (Charlotte)","description":"&lt;p&gt;Join the North Carolina Wildlife Federation Charlotte Wildlife Stewards and City of Charlotte Landscape Management for an exciting night of mothing, led by City Arborist and entomologist Laurie Reid. As the sun goes down, we will have lights and sheets set up to attract our native moths, and you\u2019re certain to see some moths you\u2019ve&hellip;&lt;/p&gt;\\n","url":"https://ncwf.org/event/moth-night-at-tag-charlotte/","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","eventStatus":"https://schema.org/EventScheduled","startDate":"2026-07-24T20:30:00-04:00","endDate":"2026-07-24T23:00:00-04:00","organizer":{"@type":"Person","name":"NCWF","description":"","url":"","telephone":"","email":"","sameAs":""},"performer":"Organization"},{"@context":"http://schema.org","@type":"Event","name":"Southport Boat Ramp Clean Up (Southport)","description":"&lt;p&gt;Join LCFW to keep plastic out of our waterways and protect wildlife in Dutchman\\'s Creek. Trash bags, litter grabbers and gloves will be provided. REGISTER HERE&lt;/p&gt;\\n","image":"https://ncwf.org/wp-content/uploads/LCFWsouthportcleanup-2.jpg","url":"https://ncwf.org/event/southport-boat-ramp-clean-up-southport/","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","eventStatus":"https://schema.org/EventScheduled","startDate":"2026-07-26T08:30:00-04:00","endDate":"2026-07-26T09:30:00-04:00","organizer":{"@type":"Person","name":"NCWF Lower Cape Fear Wildlife Chapter","description":"","url":"","telephone":"","email":"","sameAs":""},"performer":"Organization"},{"@context":"http://schema.org","@type":"Event","name":"Let&#8217;s Talk Sea Turtles (Greensboro)","description":"&lt;p&gt;Join NCWF Triad Wild Chapter for a presentation about sea turtles! Cathy McDaniel will share her journey of starting a sea turtle rescue in Saudi Arabia. She will discuss real-life accounts of rescued turtles, rehabilitation efforts, challenges and milestones achieved. There will even be a hands-on mock turtle rescue. Join us for a &quot;turtley&quot; awesome&hellip;&lt;/p&gt;\\n","url":"https://ncwf.org/event/lets-talk-sea-turtles-greensboro/","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","eventStatus":"https://schema.org/EventScheduled","startDate":"2026-07-27T18:30:00-04:00","endDate":"2026-07-27T20:00:00-04:00","organizer":{"@type":"Person","name":"NCWF Triad Wild! Chapter","description":"","url":"","telephone":"","email":"","sameAs":""},"performer":"Organization"},{"@context":"http://schema.org","@type":"Event","name":"High Country Wild Social! (West Jefferson)","description":"&lt;p&gt;High Country Wild is one of NCWF\\'s newest Community Wildlife Chapters. The chapter protects, conserves, and restores wildlife and habitat in Ashe and Watauga County. The chapter brings the local community together with opportunities to restore habitat, connect with nature, and learn about important wildlife and habitat topics in the region. Join us as we&hellip;&lt;/p&gt;\\n","image":"https://ncwf.org/wp-content/uploads/taproom.jpg","url":"https://ncwf.org/event/high-country-wild-social-west-jefferson/","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","eventStatus":"https://schema.org/EventScheduled","startDate":"2026-07-28T18:00:00-04:00","endDate":"2026-07-28T20:00:00-04:00","organizer":{"@type":"Person","name":"NCWF High Country Wild Chapter","description":"","url":"","telephone":"","email":"","sameAs":""},"performer":"Organization"},{"@context":"http://schema.org","@type":"Event","name":"Wildlife of Antioch: Exploring the Carolina Bays (Red Springs)","description":"&lt;p&gt;Join NCWF and the Nature Conservancy for an exploration of the natural communities at one of the Carolina Bays! These ancient depression ponds are found across the coastal plain of the Carolinas and provide essential habitat for many amphibians, mammals, reptiles, and arthropods. Come see what wildlife we can find between the cypress knees. REGISTER&hellip;&lt;/p&gt;\\n","image":"https://ncwf.org/wp-content/uploads/antiochTNCv2.jpg","url":"https://ncwf.org/event/carolina-bays/","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","eventStatus":"https://schema.org/EventScheduled","startDate":"2026-07-29T09:00:00-04:00","endDate":"2026-07-29T11:00:00-04:00","organizer":{"@type":"Person","name":"NCWF","description":"","url":"","telephone":"","email":"","sameAs":""},"performer":"Organization"},{"@context":"http://schema.org","@type":"Event","name":"Smoky Mountains Wilderness Watch Chapter Meeting (Waynesville)","description":"&lt;p&gt;Are you passionate about wildlife? Do you want to make a difference for natural resource management, protection, and enjoyment? Smoky Mountains Wilderness Watch is a new chapter of the North Carolina Wildlife Federation. The chapter\\'s mission is to rewild, protect, and conserve habitat creating a more livable landscape for humans and wildlife. Join chapter leaders&hellip;&lt;/p&gt;\\n","image":"https://ncwf.org/wp-content/uploads/smoky-1.jpg","url":"https://ncwf.org/event/smoky-mountains-wilderness-watch-chapter-meeting-waynesville-2/","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","eventStatus":"https://schema.org/EventScheduled","startDate":"2026-07-29T18:00:00-04:00","endDate":"2026-07-29T20:00:00-04:00","organizer":{"@type":"Person","name":"NCWF Smoky Mountains Wilderness Watch Chapter","description":"","url":"","telephone":"","email":"","sameAs":""},"performer":"Organization"},{"@context":"http://schema.org","@type":"Event","name":"Cerulean Warbler &#038; Avian Diversity Study","description":"&lt;p&gt;Join North Carolina Wildlife Federation, National Parks Conservation Association, the Center for Biological Diversity, Defenders of Wildlife, MountainTrue, and the N.C. Wildlife Resources Commission with support from the U.S. Forest Service to help with a cerulean warbler and avian diversity survey project focused on the last remaining patches of old-growth forests and maturing second-growth forests&hellip;&lt;/p&gt;\\n","url":"https://ncwf.org/event/cerulean-warbler-avian-diversity-study-9/","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","eventStatus":"https://schema.org/EventScheduled","startDate":"2026-07-30T08:00:00-04:00","endDate":"2026-07-30T16:00:00-04:00","organizer":{"@type":"Person","name":"NCWF","description":"","url":"","telephone":"","email":"","sameAs":""},"performer":"Organization"},{"@context":"http://schema.org","@type":"Event","name":"Brumley Oasis Watering Workday (Chapel Hill)","description":"&lt;p&gt;Join NCWF Tri-County Conservationists Chapter for an oasis maintenance workday! The chapter worked hard to plant and fence 8 native plant oases in Brumley Preserve South. Now comes the important work of stewarding and maintaining the native saplings in these oases. Join us to water these saplings and help them through the drought! REGISTER HERE&lt;/p&gt;\\n","url":"https://ncwf.org/event/brumley-oasis-watering-workday-chapel-hill/","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","eventStatus":"https://schema.org/EventScheduled","startDate":"2026-07-31T08:00:00-04:00","endDate":"2026-07-31T10:00:00-04:00","organizer":{"@type":"Person","name":"NCWF TriCounty Conservationists Chapter","description":"","url":"","telephone":"","email":"","sameAs":""},"performer":"Organization"},{"@context":"http://schema.org","@type":"Event","name":"Unearth A Story: Burrowing Insects (Elizabeth City)","description":"&lt;p&gt;Join Skadi Kylander with NCWF Wildlife Habitat Stewards of Northeastern NC Chapter for a lively, hands-on program about burrowing insects at Pasquotank County Library. The session begins with a presentation introducing insects and other &quot;bugs&quot; then digs deeper into the fascinating species that tunnel underground and the unique conditions they encounter beneath the surface. After&hellip;&lt;/p&gt;\\n","image":"https://ncwf.org/wp-content/uploads/burrowinginsects.jpg","url":"https://ncwf.org/event/unearth-a-story-burrowing-insects-elizabeth-city/","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","eventStatus":"https://schema.org/EventScheduled","startDate":"2026-07-31T10:30:00-04:00","endDate":"2026-07-31T11:30:00-04:00","organizer":{"@type":"Person","name":"NCWF Wildlife Habitat Stewards of NE NC Chapter","description":"","url":"","telephone":"","email":"","sameAs":""},"performer":"Organization"},{"@context":"http://schema.org","@type":"Event","name":"Bridging the Gap: Discussion of Water Quality, Community Trust, and Volunteer Communication After Hurricane Helene (Online)","description":"&lt;p&gt;Effective disaster recovery requires both environmental interventions and resilient volunteer networks. This presentation explores the intersections of environmental health, disaster response, and community resilience following Hurricane Helene in Western North Carolina. Join NCWF High Country Wild to welcome Appalachian State Graduate student Eryn Stowe as she discusses her current research and past experiences studying Hurricane&hellip;&lt;/p&gt;\\n","image":"https://ncwf.org/wp-content/uploads/thegap.jpg","url":"https://ncwf.org/event/bridging-the-gap-helene/","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","eventStatus":"https://schema.org/EventScheduled","startDate":"2026-08-06T19:00:00-04:00","endDate":"2026-08-06T20:15:00-04:00","organizer":{"@type":"Person","name":"NCWF High Country Wild Chapter","description":"","url":"","telephone":"","email":"","sameAs":""},"performer":"Organization"},{"@context":"http://schema.org","@type":"Event","name":"ecoEXPLORE Moth Night (Columbia)","description":"&lt;p&gt;Join NCWF and Pocosin Lakes National Wildlife Refuge for a special opportunity to view moths and other insects during our ecoEXPLORE Moth Night at the refuge visitor center in Columbia! All ages are invited to participate in this fun community science opportunity where we\u2019ll be uploading our observations to iNaturalist for scientists and researchers to&hellip;&lt;/p&gt;\\n","image":"https://ncwf.org/wp-content/uploads/ecoexploremothnight.jpg","url":"https://ncwf.org/event/ecoexplore-moth-night-columbia/","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","eventStatus":"https://schema.org/EventScheduled","startDate":"2026-08-07T20:30:00-04:00","endDate":"2026-08-07T22:00:00-04:00","organizer":{"@type":"Person","name":"Pocosin Lakes NWR","description":"","url":"","telephone":"","email":"","sameAs":""},"performer":"Organization"},{"@context":"http://schema.org","@type":"Event","name":"Cerulean Warbler &#038; Avian Diversity Study","description":"&lt;p&gt;Join North Carolina Wildlife Federation, National Parks Conservation Association, the Center for Biological Diversity, Defenders of Wildlife, MountainTrue, and the N.C. Wildlife Resources Commission with support from the U.S. Forest Service to help with a cerulean warbler and avian diversity survey project focused on the last remaining patches of old-growth forests and maturing second-growth forests&hellip;&lt;/p&gt;\\n","url":"https://ncwf.org/event/cerulean-warbler-avian-diversity-study-8/","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","eventStatus":"https://schema.org/EventScheduled","startDate":"2026-08-13T08:00:00-04:00","endDate":"2026-08-13T16:00:00-04:00","organizer":{"@type":"Person","name":"NCWF","description":"","url":"","telephone":"","email":"","sameAs":""},"performer":"Organization"},{"@context":"http://schema.org","@type":"Event","name":"Retracing the Lewis and Clark Expedition (Holly Springs)","description":"&lt;p&gt;Renowned National Geographic Explorer Dr. Roland Kays, in partnership with the Smithsonian\\'s National Zoo and Conservation Biology Institute, led a team of biologists to re-survey wildlife along the same route Lewis and Clark pioneered 220 years ago. NCWF South Wake Conservationists Chapter is honored to host Dr. Kays for a first-hand account of this expedition,&hellip;&lt;/p&gt;\\n","image":"https://ncwf.org/wp-content/uploads/lewisclark.jpg","url":"https://ncwf.org/event/retracing-the-lewis-and-clark-expedition-holly-springs/","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","eventStatus":"https://schema.org/EventScheduled","startDate":"2026-08-14T19:30:00-04:00","endDate":"2026-08-14T21:00:00-04:00","organizer":{"@type":"Person","name":"NCWF South Wake Conservationists Chapter","description":"","url":"","telephone":"","email":"","sameAs":""},"performer":"Organization"},{"@context":"http://schema.org","@type":"Event","name":"Pollinator Workday (Charlotte)","description":"&lt;p&gt;On this date, Central Carolinas Master Naturalists and the North Carolina Wildlife Stewards Charlotte Chapter return to lead a second volunteer workday at the Veteran\\'s Park Pollinator Pitstop, located just down from the Carolina Panthers Fitness Court. We will continue to remove Bermuda grass and other weeds from the pollinator garden along with a few&hellip;&lt;/p&gt;\\n","url":"https://ncwf.org/event/pollinator-workday-charlotte/","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","eventStatus":"https://schema.org/EventScheduled","startDate":"2026-08-15T08:00:00-04:00","endDate":"2026-08-15T11:00:00-04:00","organizer":{"@type":"Person","name":"NCWF Charlotte Wildlife Stewards Chapter","description":"","url":"","telephone":"","email":"","sameAs":""},"performer":"Organization"},{"@context":"http://schema.org","@type":"Event","name":"Great Southeast Pollinator Census (Marvin)","description":"&lt;p&gt;The Great Southeast Pollinator Census is the perfect Community Science event. This is great for almost all ages, and no experience is required. As long as you can count, the rest is easy. Join NCWF Habitat Builders of West Union Chapter and learn about pollinator plants and how to identify our most common pollinators. We&hellip;&lt;/p&gt;\\n","image":"https://ncwf.org/wp-content/uploads/HBGSEPC-1.png","url":"https://ncwf.org/event/great-southeast-pollinator-census-marvin-2/","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","eventStatus":"https://schema.org/EventScheduled","startDate":"2026-08-21T13:00:00-04:00","endDate":"2026-08-21T15:00:00-04:00","organizer":{"@type":"Person","name":"NCWF Habitat Builders Chapter","description":"","url":"","telephone":"","email":"","sameAs":""},"performer":"Organization"}]
</script>

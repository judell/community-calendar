ATTACH;FMTTYPE=image/png:https://unitedarts.org/wp-content/uploads/2026/03/Apex-Community-Dance-Instagram-Post-500-x-500-px-1.png
ORGANIZER;CN="The Halle Cultural Arts Center":MAILTO:halleculturalartscenter@apexnc.org

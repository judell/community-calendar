<style id="cavalree/paragraph-inline-css">
@layer cavalree {
	:where([data-cavalree="paragraph"i], [data-cavalree^="paragraph@"i]) {
		--c-text--case: var(--c--typography--body--case);
		--c-text--family: var(--c--typography--body--family);
		--c-text--line-height--16: 1.5;
		--c-text--line-height--24: 1.375;
		--c-text--size--16: 1rem;
		--c-text--size--24: clamp(var(--c-text--size--min, 1.125rem), 1.5cqi * var(--c-text--offset, 1), 1.5rem);
		--c-text--tracking: var(--c--typography--body--tracking);

		hanging-punctuation: first;
		text-decoration: none;

		&:empty {
			display: none;
		}
	}

	:where([data-cavalree="paragraph/asset"i], [data-cavalree^="paragraph/asset@"i]) {
	}

	:where([data-cavalree="paragraph/content"i], [data-cavalree^="paragraph/content@"i]) {

		& :any-link:not([href*="stevensandsmithcenter"i], [href^="tel:"i], [href^="mailto:"i], [href^="/"i])::after {
			content: "\00A0\2197";
		}
	}

	:where([data-cavalree="paragraph/figure"i], [data-cavalree^="paragraph/figure@"i]) {
	}

	:where([data-cavalree="paragraph/inner"i], [data-cavalree^="paragraph/inner@"i]) {
	}

	:where([data-cavalree="paragraph/kicker"i], [data-cavalree^="paragraph/kicker@"i]) {
	}

	:where([data-cavalree="paragraph/label"i], [data-cavalree^="paragraph/label@"i]) {
		& em {
			letter-spacing: 0.015625em;
		}

		& :any-link {
			color: inherit !important;
			font-weight: 700;
			text-decoration-color: var(--c--color--text-decoration);
			text-decoration-line: underline;
			text-decoration-thickness: 2px;
			text-underline-offset: 2px;
			transition-duration: 125ms;
			transition-property: text-decoration-thickness;
			transition-timing-function: ease;

			&:hover {
				text-decoration-thickness: 3px;
			}
		}
	}
}

@layer cavalree {
	[data-cavalree="paragraph"i] {
	}


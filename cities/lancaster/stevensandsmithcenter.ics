<style id="cavalree/button@social-inline-css">
@layer cavalree {
	[data-cavalree="button@social"i] {
		--c-box--color--canvas: var(--c--color--text);

		aspect-ratio: 1;
		block-size: 1.25rem;
		display: block flow;
		mask-repeat: no-repeat;
		mask-position: 50%;
		mask-size: contain;
		scale: 1;
		transition-duration: 250ms;
		transition-property: scale;
		transition-timing-function: ease;

		&:is(:focus-visible, :hover) {
			scale: 1.125;
		}

		&[href*="facebook"i] {
			mask-image: url("/wp-content/themes/cavalree/images/icon--facebook.svg");
		}

		&[href*="instagram"i] {
			mask-image: url("/wp-content/themes/cavalree/images/icon--instagram.svg");
		}

		&[href*="youtube"i] {
			block-size: 1.625rem;
			mask-image: url("/wp-content/themes/cavalree/images/icon--youtube.svg");
		}

	}

	[data-cavalree="button/asset@social"i] {
	}

	[data-cavalree="button/content@social"i] {
		block-size: 1px;
		border-width: 0px;
		clip-path: inset(50%);
		inline-size: 1px;
		margin: -1px;
		overflow: hidden;
		padding: 0px;
		position: absolute;
		white-space: nowrap;
	}

	[data-cavalree="button/figure@social"i] {
	}


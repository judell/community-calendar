<link rel='stylesheet' id='c-box-css' href='https://stevensandsmithcenter.org/wp-content/plugins/cavalree-blocks/assets/c-box.css?ver=1.1.0' media='all' />
<style id="c-cluster-inline-css">
@layer cavalree.system {
	.c-cluster {
		--_c-cluster--threshold: max(0rem, (var(--c-cluster--threshold) - 100cqi) * 10000);

		--c-cluster--gap: 0rem;
		--c-cluster--gap--block: var(--c-cluster--gap);
		--c-cluster--gap--inline: var(--c-cluster--gap);
		--c-cluster--place: normal;
		--c-cluster--place--block: var(--c-cluster--place);
		--c-cluster--place--inline: var(--c-cluster--place);
		--c-cluster--threshold: var(--c--length--content--sm, 50rem);

		align-items: var(--c-cluster--place--block);
		column-gap: var(--c-cluster--gap--inline);
		display: block flex;
		flex-wrap: wrap;
		justify-content: var(--c-cluster--place--inline);
		row-gap: var(--c-cluster--gap--block);
	}

	.c-cluster_item {
		flex-basis: var(--c-cluster_item--flex-basis, auto);
		min-inline-size: max-content;
	}
}

/*# sourceURL=https://stevensandsmithcenter.org/wp-content/plugins/cavalree-blocks/assets/c-cluster.css */
</style>
<style id="c-composition-inline-css">
@layer cavalree.system {
	.c-composition {
		--c-composition--gap: 0rem;
		--c-composition--place: normal;
		--c-composition--place--block: var(--c-composition--place);
		--c-composition--place--inline: var(--c-composition--place);
		--c-composition--size: none;
		--c-composition--space: 0rem;

		align-items: var(--c-composition--place--block);
		column-gap: var(--c-composition--gap);
		display: block grid;
		justify-items: var(--c-composition--place--inline);
		row-gap: var(--c-composition--gap);
	}

	.c-composition_item {
		--_c-composition_item--size: var(--c-composition--size);
		--c-composition_item--space: var(--c-composition--space);

		.c-composition_item + & {
			margin-block-start: var(--c-composition_item--space);
		}

		inline-size: 100%;
		max-inline-size: var(--_c-composition_item--size);
	}
}

/*# sourceURL=https://stevensandsmithcenter.org/wp-content/plugins/cavalree-blocks/assets/c-composition.css */
</style>
<style id="c-container-inline-css">
@layer cavalree.system {
	.c-container {
		--c-container--type: inline-size;

		container-type: var(--c-container--type);
	}
}

/*# sourceURL=https://stevensandsmithcenter.org/wp-content/plugins/cavalree-blocks/assets/c-container.css */
</style>
<link rel='stylesheet' id='c-content-sidebar-css' href='https://stevensandsmithcenter.org/wp-content/plugins/cavalree-blocks/assets/c-content-sidebar.css?ver=1.1.0' media='all' />
<style id="c-flow-inline-css">
@layer cavalree.system {
	.c-flow {
		--c-flow--space: 0rem;
	}

	.c-flow_item {
		--c-flow_item--space: var(--c-flow--space);

		:where(&) {
			display: block flow;
		}

		.c-flow_item + & {
			margin-block-start: var(--c-flow_item--space);
		}
	}
}

/*# sourceURL=https://stevensandsmithcenter.org/wp-content/plugins/cavalree-blocks/assets/c-flow.css */
</style>
<style id="c-frame-inline-css">
@layer cavalree.system {
	.c-frame {
		--c-frame--ratio: auto;

		aspect-ratio: var(--c-frame--ratio);
		display: block flow;
		inline-size: 100%;
		max-inline-size: 100%;
		object-fit: cover;
	}
}

/*# sourceURL=https://stevensandsmithcenter.org/wp-content/plugins/cavalree-blocks/assets/c-frame.css */
</style>
<style id="c-grid-inline-css">
@layer cavalree.system {
	.c-grid {
		--c-grid--gap: 0rem;
		--c-grid--gap--block: var(--c-grid--gap);
		--c-grid--gap--inline: var(--c-grid--gap);
		--c-grid--size: var(--c--size--card, 20rem);

		column-gap: var(--c-grid--gap--inline);
		display: block grid;
		grid-template-columns: repeat(auto-fit, minmax(min(var(--c-grid--size), 100cqi), 1fr));
		row-gap: var(--c-grid--gap--block);
	}

	.c-grid_item {
	}
}

/*# sourceURL=https://stevensandsmithcenter.org/wp-content/plugins/cavalree-blocks/assets/c-grid.css */
</style>
<style id="c-reel-inline-css">
@layer cavalree.system {
	.c-reel {
		--c-reel--gap: 0rem;
		--c-reel--place: start;
		--c-reel--place--block: var(--c-reel--place);
		--c-reel--scrollbar: 1rem;
		--c-reel--size: var(--c--size--card, 20rem);

		align-items: var(--c-reel--place--block);
		column-gap: var(--c-reel--gap);
		display: block flex;
		padding-block: var(--c-reel--scrollbar);
		margin-block: calc(var(--c-reel--scrollbar) * -1);
		overflow-x: auto;
		overflow-y: clip;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
	}

	.c-reel_item {
		--_c-reel_item--size: var(--c-reel--size);

		--c-reel_item--target: none;

		flex-basis: var(--_c-reel_item--size);
		flex-grow: 0;
		flex-shrink: 0;
		scroll-initial-target: var(--c-reel_item--target);
		scroll-snap-align: center;

		&:not(* ~ .c-reel_item) {
			margin-inline-start: max(var(--c--size--gutter--site, 2rem), (100cqi - var(--c--size--viewport, 100rem)) / 2);
		}

		&:not(:has(~ .c-reel_item)) {
			margin-inline-end: calc(50cqi - (var(--_c-reel_item--size) / 2));
		}
	}
}

/*# sourceURL=https://stevensandsmithcenter.org/wp-content/plugins/cavalree-blocks/assets/c-reel.css */
</style>
<style id="c-stack-inline-css">
@layer cavalree.system {
	.c-stack {
		--c-stack--gap: 0rem;
		--c-stack--space: 0rem;

		display: block flex;
		flex-direction: column;
		justify-content: start;
		row-gap: var(--c-stack--gap);
	}

	.c-stack_item {
		--c-stack_item--space: var(--c-stack--space);
		--c-stack_item--space-end: 0rem;

		margin-block: 0rem;

		.c-stack_item + & {
			margin-block-start: var(--c-stack_item--space);
		}

		&:has(+ .c-stack_item) {
			margin-block-end: var(--c-stack_item--space-end);
		}
	}
}

/*# sourceURL=https://stevensandsmithcenter.org/wp-content/plugins/cavalree-blocks/assets/c-stack.css */
</style>
<style id="c-switcher-inline-css">
@layer cavalree.system {
	.c-switcher {
		--c-switcher--gap: 0rem;
		--c-switcher--gap--block: var(--c-switcher--gap);
		--c-switcher--gap--inline: var(--c-switcher--gap);
		--c-switcher--place: start;
		--c-switcher--place--block: var(--c-switcher--place);
		--c-switcher--threshold: var(--c--size--threshold, 50rem);

		align-items: var(--c-switcher--place--block);
		column-gap: var(--c-switcher--gap--inline);
		display: block flex;
		flex-wrap: wrap;
		row-gap: var(--c-switcher--gap--block);
	}

	.c-switcher_item {
		--_c-switcher_item--threshold: var(--c-switcher--threshold);

		flex-basis: calc((var(--_c-switcher_item--threshold) - 100cqi) * 1000);
		flex-grow: 1;
	}
}

/*# sourceURL=https://stevensandsmithcenter.org/wp-content/plugins/cavalree-blocks/assets/c-switcher.css */
</style>
<style id="c-tabs-inline-css">
@property --_c-tabs_item--count {
	syntax: "<integer>";
	inherits: true;
	initial-value: 1;
}

@property --_c-tabs_item--index {
	syntax: "<integer>";
	inherits: true;
	initial-value: 1;
}

@layer cavalree.system {
	.c-tabs {
		--_c-tabs--scrollbar: var(--c--size--gutter, 2rem);

		--c-tabs--gap: 0rem;
		--c-tabs--gap--block: var(--c-tabs--gap);
		--c-tabs--gap--inline: var(--c-tabs--gap);

		column-gap: var(--c-tabs--gap--inline);
		display: block grid;
		grid-auto-columns: max-content;
		grid-template-rows: auto 1fr;
		margin-block-start: calc(var(--_c-tabs--scrollbar) * -1);
		overflow-x: auto;
		overflow-y: visible;
		padding-block-start: var(--_c-tabs--scrollbar);
		scrollbar-width: none;
	}

	.c-tabs_item {
		--_c-tabs_item--count: sibling-count();
		--_c-tabs_item--index: sibling-index();

		column-gap: var(--c-tabs--gap--inline);
		grid-column-end: span var(--_c-tabs_item--count);
		grid-column-start: 1;
		grid-row-end: -1;
		grid-row-start: 1;
		grid-template-columns: subgrid;
		grid-template-rows: subgrid;
		pointer-events: none;
		row-gap: var(--c-tabs--gap--block);

		& > * {
			pointer-events: auto;
		}

		& > button {
			grid-column-end: calc(var(--_c-tabs_item--index) + 1);
			grid-column-start: var(--_c-tabs_item--index);
		}

		& > div {
			grid-column-end: -1;
			grid-column-start: 1;
			inline-size: 100cqi;
			inset-inline-start: 0rem;
			position: sticky !important;
		}

		&:not([open]) > div {
			display: none;
		}
	}
}

/*# sourceURL=https://stevensandsmithcenter.org/wp-content/plugins/cavalree-blocks/assets/c-tabs.css */
</style>
<style id="c-text-inline-css">
@layer cavalree.system {
	.c-text {
		--c-text--align: inherit;
		--c-text--case: inherit;
		--c-text--decoration: inherit;
		--c-text--family: inherit;
		--c-text--line-height: inherit;
		--c-text--size: inherit;
		--c-text--tracking: inherit;
		--c-text--weight: inherit;

		font-family: var(--c-text--family);
		font-size: var(--c-text--size);
		font-weight: var(--c-text--weight);
		letter-spacing: var(--c-text--tracking);
		line-height: var(--c-text--line-height);
		text-align: var(--c-text--align);
		text-decoration-line: var(--c-text--decoration);
		text-transform: var(--c-text--case);
	}
}

/*# sourceURL=https://stevensandsmithcenter.org/wp-content/plugins/cavalree-blocks/assets/c-text.css */
</style>
<link rel='stylesheet' id='cavalree-css' href='https://stevensandsmithcenter.org/wp-content/themes/cavalree/assets/index.css?ver=1.1.1' media='all' />
<style id="cavalree/button-inline-css">
@layer cavalree {
	:where([data-cavalree="button"i], [data-cavalree^="button@"i]) {
		--c-box--color--border: var(--c--color--button-border);
		--c-box--color--canvas: var(--c--color--button-canvas);
		--c-box--color--text: var(--c--color--button-text);
		--c-box--cursor: pointer;

		--c-text--align: center;
		--c-text--decoration: none;
		--c-text--family: var(--c--typography--button--family);
		--c-text--line-height: 1.25;
		--c-text--tracking: var(--c--typography--button--tracking);
		--c-text--weight: var(--c--typography--button--weight);

		text-decoration-line: var(--c-text--decoration);
	}

	:where([data-cavalree="button/asset"i], [data-cavalree^="button/asset@"i]) {
	}

	:where([data-cavalree="button/content"i], [data-cavalree^="button/content@"i]) {
	}

	:where([data-cavalree="button/figure"i], [data-cavalree^="button/figure@"i]) {
	}

	:where([data-cavalree="button/inner"i], [data-cavalree^="button/inner@"i]) {
	}

	:where([data-cavalree="button/kicker"i], [data-cavalree^="button/kicker@"i]) {
	}

	:where([data-cavalree="button/label"i], [data-cavalree^="button/label@"i]) {
	}
}

@layer cavalree {
	[data-cavalree="button"i] {
		--c-box--border--size: 1px;
		--c-box--padding--block: calc(1rem - var(--c-box--border--size));
		--c-box--padding--inline: calc(2rem - var(--c-box--border--size));

		--c-composition--place: center;

		scale: 1;
		transition-duration: 250ms;
		transition-property: scale;
		transition-timing-function: ease;

		&:any-link:not([href*="stevensandsmithcenter"i], [href^="tel:"i], [href^="mailto:"i], [href^="/"i]) {
			& [data-cavalree="button/content"i]::after {
				content: "\00A0\2197";
			}
		}

		&:any-link[target="_blank"i] {
			& [data-cavalree="button/content"i]::after {
				content: "\00A0\2197";
			}
		}

		&:is(:focus-visible, :hover) {
			scale: 1.0625;
		}
	}

	[data-cavalree="button/asset"i] {
	}

	[data-cavalree="button/content"i] {
	}

	[data-cavalree="button/figure"i] {
	}

	[data-cavalree="button/inner"i] {
	}

	[data-cavalree="button/kicker"i] {
	}

	[data-cavalree="button/label"i] {
	}
}

/*# sourceURL=https://stevensandsmithcenter.org/wp-content/themes/cavalree/assets/cavalree/button.css */
</style>
<style id="cavalree/button@text-inline-css">
@layer cavalree {
	[data-cavalree="button@text"i] {
		--c--color--button-canvas: transparent;
		--c--color--button-text: currentcolor;

		--c-box--padding--block: calc(0.5rem - var(--c-box--border--size));

		--c-text--align: inherit;
		--c-text--size: inherit;
		--c-text--weight: inherit;

		/* &:any-link {
			--c-text--decoration: underline;

			text-decoration-color: var(--c--color--text-decoration);
			text-decoration-thickness: 0px;
			text-underline-offset: 3px;
			transition-duration: 125ms;
			transition-property: text-decoration-thickness;
			transition-timing-function: ease;

			&:hover {
				text-decoration-thickness: 2px;
			}
		} */
	}

	[data-cavalree="button/asset@text"i] {
	}

	[data-cavalree="button/content@text"i] {
		text-decoration-thickness: inherit;
	}

	[data-cavalree="button/figure@text"i] {
	}

	[data-cavalree="button/inner@text"i] {
	}

	[data-cavalree="button/kicker@text"i] {
	}

	[data-cavalree="button/label@text"i] {
		text-decoration-thickness: inherit;
	}
}

/*# sourceURL=https://stevensandsmithcenter.org/wp-content/themes/cavalree/assets/cavalree/button/text.css */
</style>
<link rel='stylesheet' id='cavalree/section-css' href='https://stevensandsmithcenter.org/wp-content/themes/cavalree/assets/cavalree/section.css?ver=1.1.1' media='all' />
<style id="cavalree/section@site-topbar-inline-css">
@layer cavalree {
	[data-cavalree="section@site-topbar"i] {
		--c--color--canvas: var(--_c--color--navy);
		--c--color--text: var(--_c--color--white);

		--c-box--padding--block: var(--c--size--gutter--xs);

		--c-composition--size: var(--c--size--viewport);
	}

	[data-cavalree="section/asset@site-topbar"i] {
	}

	[data-cavalree="section/content@site-topbar"i] {
	}

	[data-cavalree="section/figure@site-topbar"i] {
	}

	[data-cavalree="section/inner@site-topbar"i] {
		--c-cluster--gap: var(--c--size--gutter);
		--c-cluster--place--block: center;
		--c-cluster--place--inline: end;

		& [data-cavalree="button@text"i] {
			--c-box--padding--block: 0rem;

			--c-text--case: uppercase;
			--c-text--line-height: 1rem;
			--c-text--size: 0.75rem;
			--c-text--tracking: calc(1em / 12);
			--c-text--weight: 700;

			&[href*="hours-admission"] {
				--c-box--color--text: var(--_c--color--parchment);

				--c-text--case: none;
				--c-text--size: 0.875rem;
				--c-text--tracking: 0em;
				--c-text--weight: 700;
			}
		}
	}

	[data-cavalree="section/kicker@site-topbar"i] {
	}

	[data-cavalree="section/label@site-topbar"i] {
	}
}

/*# sourceURL=https://stevensandsmithcenter.org/wp-content/themes/cavalree/assets/cavalree/section/site-topbar.css */
</style>
<style id="cavalree/media-inline-css">
@layer cavalree {
	:where([data-cavalree="media"i], [data-cavalree^="media@"i]) {
		--c-stack_item--space: calc(var(--c-stack--space) * 3);
		--c-stack_item--space-end: var(--c-stack--space);

		&:any-link {
			--c-box--cursor: pointer;
		}
	}

	:where([data-cavalree="media/asset"i], [data-cavalree^="media/asset@"i]) {
		&[data-media-id="530"i] {
			object-position: 50% 20%;
		}
	}

	:where([data-cavalree="media/content"i], [data-cavalree^="media/content@"i]) {
	}

	:where([data-cavalree="media/figure"i], [data-cavalree^="media/figure@"i]) {
	}

	:where([data-cavalree="media/inner"i], [data-cavalree^="media/inner@"i]) {
		display: none;
	}

	:where([data-cavalree="media/kicker"i], [data-cavalree^="media/kicker@"i]) {
	}

	:where([data-cavalree="media/label"i], [data-cavalree^="media/label@"i]) {
	}
}

@layer cavalree {
	[data-cavalree="media"i] {
	}


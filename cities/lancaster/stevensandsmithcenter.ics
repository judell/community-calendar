<style id="cavalree/section@copyright-notice-inline-css">
@layer cavalree {
	[data-cavalree="section@copyright-notice"i] {
		--c--color--canvas: var(--_c--color--linen);
		--c--color--text: var(--_c--color--navy);

		--c-box--padding--block: var(--c--size--gutter--xs);

		--c-composition--size: var(--c--size--viewport);

		--c-text--align: center;
		--c-text--size: 0.75rem;
		--c-text--weight: 700;
	}

	[data-cavalree="section/inner@copyright-notice"i] {
		--_c-cluster_item--basis: var(--_c-cluster--threshold);

		--c-cluster--gap: 0.25rem;
		--c-cluster--place--inline: space-between;
		--c-cluster--threshold: 65rem;

		& :is([data-cavalree="paragraph"i], [data-cavalree^="paragraph@"i]) {
			--c-box--padding--block: 0.34375rem;

			--c-text--case: var(--c--typography--display--case);
			--c-text--family: var(--c--typography--display--family);
			--c-text--line-height: 1;
			--c-text--size: 1rem;
			--c-text--tracking: var(--c--typography--display--tracking);
			--c-text--weight: var(--c--typography--display--weight);

			& :is([data-cavalree="paragraph/label"i], [data-cavalree^="paragraph/label@"i]) {
				align-items: center;
				column-gap: 0.75ch;
				display: block flex;
				flex-wrap: nowrap;
				justify-content: center;

				&::after {
					aspect-ratio: calc(8 / 1);
					background-image: url("/wp-content/themes/cavalree/images/lancasterhistory.svg");
					block-size: 1.25rem;
					content: "";
					display: block flow;
				}
			}

			& :is([data-cavalree="paragraph/kicker"i], [data-cavalree^="paragraph/kicker@"i]) {
				block-size: 1px;
				border-width: 0px;
				clip-path: inset(50%);
				inline-size: 1px;
				margin: -1px;
				overflow: hidden;
				padding: 0px;
				position: absolute;
				white-space: nowrap;
			}
		}

		& .c-container {
			container-type: normal;
		}

		:where(& > [data-cavalree]) {
			flex-basis: var(--_c-cluster_item--basis);
			min-inline-size: fit-content;
			text-wrap: nowrap;
		}

		& [data-cavalree="buttons/inner"i] {
			--_c-cluster_item--basis: var(--_c-cluster--threshold);

			--c-cluster--gap: var(--c--size--gutter--sm);
			--c-cluster--place--inline: center;
			--c-cluster--threshold: 20rem;

			& [href*="infantree.com"i] {
				--c-text--weight: 400;
			}
		}
	}
}

/*# sourceURL=https://stevensandsmithcenter.org/wp-content/themes/cavalree/assets/cavalree/section/copyright-notice.css */
</style>

		--c-content-sidebar--gap--block: var(--c--size--gutter--lg);
		--c-content-sidebar--place--block: start;
		--c-content-sidebar_item--size--content: 20cqi;
		--c-content-sidebar_item--size--sidebar: clamp(50rem, 70cqi, 60rem);

		& [data-cavalree="heading"i] {
			--c-text--size: 1.5rem;
		}

		& [data-cavalree="button"i] {
			--c-box--padding--block: calc(0.625rem - var(--c-box--border--size));
		}

		@media (width < 66.5rem) {
			& .c-content-sidebar_item > [data-cavalree="group/inner"i] {
				--c-text--align: center;

				& [data-cavalree="buttons/inner"i] {
					align-items: center;
					justify-content: center;
				}
			}
		}

		@media (width < 50rem) {
			& [data-cavalree="group/inner"i] {
				--c-text--align: center;

				& [data-cavalree="buttons/inner"i] {

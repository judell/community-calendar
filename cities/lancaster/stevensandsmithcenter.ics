@layer cavalree {
	[data-cavalree="section@call-to-action"i] {
		--c--color--canvas: var(--_c--color--cobalt);
		--c--color--text: var(--_c--color--sky-blue);
		--c--color--button-canvas: var(--_c--color--sky-blue);
		--c--color--button-text: var(--_c--color--navy);

		--c-box--padding--block--end: 0px;
		--c-box--padding--block--start: var(--c--size--gutter--lg);

		--c-composition--size: var(--c--size--viewport);
	}

	[data-cavalree="section/asset@call-to-action"i] {
	}

	[data-cavalree="section/content@call-to-action"i] {
	}

	[data-cavalree="section/figure@call-to-action"i] {
	}

	[data-cavalree="section/inner@call-to-action"i] {
		--c-content-sidebar--gap--inline: var(--c--size--gutter--xl);

		margin-block-end: calc(var(--c--size--gutter--lg) * -1);

		& :is([data-cavalree="group"i], [data-cavalree^="group@"i]) {
			--c-box--padding--block: calc(var(--c--size--gutter--lg) * 2);

			--c-composition--size: var(--c--size--content--sm);
			--c-composition--place: center;

			margin-block-start: calc(var(--c--size--gutter--lg) * -2);
		}

		& :is([data-cavalree="heading"i], [data-cavalree^="heading@"i]) {
			--c-text--line-height: var(--c-text--line-height--110);
			--c-text--size: var(--c-text--size--110);
			--c-text--weight: 700;
		}

		& :is([data-cavalree="heading/kicker"i], [data-cavalree^="heading/kicker@"i]) {
			--c-text--case: var(--c--typography--display--case);
			--c-text--family: var(--c--typography--display--family);
			--c-text--line-height: var(--c-text--line-height--40);
			--c-text--size: var(--c-text--size--40);
			--c-text--tracking: var(--c--typography--display--tracking);
			--c-text--weight: var(--c--typography--display--weight);
		}

		& :is([data-cavalree="heading/label"i], [data-cavalree^="heading/label@"i]) {
			--c-flow--space: var(--c--size--gutter);
		}

		& :is([data-cavalree="media"i], [data-cavalree^="media@"i]) {
			--c-box--padding: var(--c--size--gutter);
		}

		@container (inline-size < 50rem) {
			& :is([data-cavalree="media"i], [data-cavalree^="media@"i]) {
				margin-block-start: calc(var(--c--size--gutter--lg) * -1.5);
				order: 1;

<style id="cavalree/menu-inline-css">
@layer cavalree {
	:where([data-cavalree="menu"i], [data-cavalree^="menu@"i]) {
		--c-composition--place--inline: stretch;
	}

	:where([data-cavalree="menu/asset"i], [data-cavalree^="menu/asset@"i]) {
	}

	:where([data-cavalree="menu/content"i], [data-cavalree^="menu/content@"i]) {
		display: none;
	}

	:where([data-cavalree="menu/figure"i], [data-cavalree^="menu/figure@"i]) {
	}

	:where([data-cavalree="menu/icon"i], [data-cavalree^="menu/icon@"i]) {
		aspect-ratio: 1;
		block-size: 1.5rem;
		inset-block-start: calc(50% - 0.75rem);
		inset-inline-end: 0px;

		& > svg {
			fill: currentcolor;
		}
	}

	:where([data-cavalree="menu/inner"i], [data-cavalree^="menu/inner@"i]) {
		--c-cluster--gap: var(--c--size--gutter--sm);
		--c-cluster--place--block: center;
		--c-cluster--place--inline: end;
		--c-cluster--threshold: 70rem;
		--c-cluster_item--flex-basis: var(--_c-cluster--threshold);

		--c-container--type: normal;

		& > :is([data-cavalree="button"i], [data-cavalree^="button@"i]) {
			--c--color--button-border: transparent;
			--c--color--button-canvas: var(--_c--color--brick-red);
			--c--color--button-text: var(--_c--color--white);
		}

		:is([data-cavalree="media/asset"i], [data-cavalree^="media/asset@"i]) {
			--c-frame--ratio: calc(3 / 2);
		}
	}

	:where([data-cavalree="menu/kicker"i], [data-cavalree^="menu/kicker@"i]) {
	}

	:where([data-cavalree="menu/label"i], [data-cavalree^="menu/label@"i]) {
		--c-box--cursor: pointer;

		--c-container--type: normal;

		justify-self: end;
		list-style-type: none;
		max-inline-size: fit-content;
	}
}


X-SOURCE-URLS:{"Apostlesucc": "https://apostlesucc.org/event/breakfast-with-santa-holiday-bazaar/"}
X-SOURCE-ID:apostlesucc
X-SOURCE:Church of the Apostles UCC
DTSTART;TZID=America/New_York:20261212T084500
DTEND;TZID=America/New_York:20261212T120000

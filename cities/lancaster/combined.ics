X-SOURCE-URLS:{"Saintjameslancaster": "https://www.saintjameslancaster.org/event/evening-prayer-2023-07-05-2-2-3/2026-11-18/"}
X-SOURCE-ID:saintjameslancaster
X-SOURCE:Saint James Lancaster
DTSTART;TZID=America/New_York:20261118T173000
DTEND;TZID=America/New_York:20261118T180000

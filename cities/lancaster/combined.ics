X-SOURCE-URLS:{"Figlancaster": "https://figlancaster.com/event/lipf-presents-american-string-quartet-ruiqi-fang/"}
X-SOURCE-ID:figlancaster
X-SOURCE:Fig Lancaster
DTSTART;TZID=America/New_York:20260717T190000
DTEND;TZID=America/New_York:20260717T204500

X-SOURCE-URLS:{"Mickeysblackbox": "https://mickeysblackbox.com/event/reprise-recreating-iconic-phish-shows/"}
X-SOURCE-ID:mickeysblackbox
X-SOURCE:Mickey's Black Box
DTSTART;TZID=America/New_York:20261119T190000
DTEND;TZID=America/New_York:20261119T230000

X-SOURCE-URLS:{"Lancastersciencefactory": "https://lancastersciencefactory.org/event/girl-scout-badge-workshops-robotics/2026-10-17/"}
X-SOURCE-ID:lancastersciencefactory
X-SOURCE:Lancaster Science Factory
DTSTART;TZID=America/New_York:20261017T133000

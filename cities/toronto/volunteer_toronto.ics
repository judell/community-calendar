BEGIN:VEVENT
SUMMARY:English Conversation Circle
DTSTART;TZID=America/Toronto:20260918T100000
DTEND;TZID=America/Toronto:20260918T110000
UID:695937125793ab29d3a67d6e@tpl.bibliocommons.com
DESCRIPTION:Are you learning English or new to Canada?\nPractice your Engl
 ish conversation skills in a relaxing environment while making new friends
  and learning about what the library has to offer!\nPlease note that this 
 is not a formal English class.
LOCATION:Malvern
URL:https://tpl.bibliocommons.com/v2/events/695937125793ab29d3a67d6e
X-SOURCE:Volunteer Toronto
END:VEVENT

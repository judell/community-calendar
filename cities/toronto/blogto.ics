BEGIN:VEVENT
SUMMARY:Epic Wagner-Legends & Lore with your Toronto Symphony Orchestra
DTSTART;TZID=America/Toronto:20260514T193000
DTEND;TZID=America/Toronto:20260514T213000
UID:blogto-234384@blogto.com

X-SOURCE-URLS:{"Engineering Engineering Events": "https://www.engineering.utoronto.ca/event/hong-kong-technical-visit-in-shenzhen/"}
X-SOURCE-ID:engineering_engineering_events
X-SOURCE:UofT Engineering
DTSTART;TZID=Asia/Shanghai:20261111T080000
DTEND;TZID=Asia/Shanghai:20261111T173000

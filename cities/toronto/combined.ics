X-SOURCE-URLS:{"Torontounion Toronto Union Events": "https://torontounion.ca/event/fred-victors-2026-holiday-campaign/"}
X-SOURCE-ID:torontounion_toronto_union_events
X-SOURCE:Union Station Toronto
DTSTART;TZID=America/Toronto:20261119T063000
DTEND;TZID=America/Toronto:20261119T190000
DTSTAMP:20261029T175622Z
CREATED:20261029T175622Z
LAST-MODIFIED:20261029T175622Z
UID:22015-1795069800-1795114800@torontounion.ca
SUMMARY:Fred Victor's 2026 Holiday Campaign
DESCRIPTION:Fred Victor’s 2026 Holiday Campaign\, Homelessness Takes Away Everyday Moments\, brings oversized everyday objects to Union Station to highlight the simple comforts and routines that people experiencing homelessness often go without. The installation invites Torontonians to see homelessness from a different perspective and support people on their journey to housing.
URL:https://torontounion.ca/event/fred-victors-2026-holiday-campaign/
LOCATION:GO York Concourse
ATTACH;FMTTYPE=image/png:https://torontounion.ca/wp-content/uploads/2026/10/fred-cr.png
END:VEVENT

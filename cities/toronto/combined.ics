X-SOURCE-URLS:{"Meetup Toronto Heavy Boardgamers": "https://www.meetup.com/toronto-heavy-boardgamers/events/316231810/"}
X-SOURCE-ID:meetup_toronto_heavy_boardgamers
X-SOURCE:Meetup: Toronto Heavy Boardgamers
UID:event_316231810@meetup.com
SEQUENCE:1

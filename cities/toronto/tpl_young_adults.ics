BEGIN:VEVENT
SUMMARY:The SciFi and Fantasy Book Club
DTSTART;TZID=America/Toronto:20260919T143000
DTEND;TZID=America/Toronto:20260919T160000
UID:6a209046bd892a0672e787ac@tpl.bibliocommons.com

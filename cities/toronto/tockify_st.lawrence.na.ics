BEGIN:VEVENT
X-SOURCE:St. Lawrence Neighbourhood Association
UID:TKF/58a507e3df82fe46974d9cbd/292/29715300/0/0
DTSTART:20260701T150000Z
DTEND:20260701T220000Z

[{"@context":"https://schema.org","@type":"Event","name":"Habitat Restoration at Almack Easement","description":"Join us this summer at Ontario Nature\u2019s Almack Easement in Claremont for a hands-on community restoration event, where you\u2019ll help remove invasive species and support the recovery of diverse Carolinian woodland and wetland habitats. Learn to identify and manage invasive plants while contributing to the long-term protection of this ecologically rich, locally owned conservation property.&hellip;","image":"","url":"https://ontarionature.org/eventcal/habitat-restoration-at-almack-easement-2/","startDate":"2026-06-06T08:15:00-04:00","endDate":"2026-06-06T15:30:00-04:00","duration":"PT7H15M","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://ontarionature.org/eventcal/habitat-restoration-at-almack-easement-2/"}},{"@context":"https://schema.org","@type":"Event","name":"Kingston Field Naturalists 2026 BioBlitz","description":"&nbsp; This will be the Kingston Field Naturalists\u2019 28th BioBlitz with a goal to record 1,000 species in a 24-hour period with 100 people! We hope that everyone will find it a fun and educational event. Come for any or all of the time. No expertise required. BioBlitzes originated in 1996 in the United States.&hellip;","image":"","url":"https://ontarionature.org/eventcal/kingston-field-naturalists-2026-bioblitz-2/","startDate":"2026-06-12T00:00:00-04:00","endDate":"2026-06-14T00:00:59-04:00","duration":"PD2TH0M0","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://ontarionature.org/eventcal/kingston-field-naturalists-2026-bioblitz-2/"}},{"@context":"https://schema.org","@type":"Event","name":"Our ORM Our Future","description":"This Is a Critical Year for the ORM - Join Us in Uxbridge With municipal elections this fall and the next Greenbelt review looming on the horizon, the decisions being made over the next year will determine the future of the ORM for the decade to come. On Saturday, June 13, 2026, STORM will gather&hellip;","image":"","url":"https://stormcoalition.com/events/our-orm","startDate":"2026-06-13T10:00:00-04:00","endDate":"2026-06-13T12:00:00-04:00","duration":"PT2H","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@context":"https://schema.org","@type":"Place","name":"Uxbridge Historical Centre","description":"","url":"https://ontarionature.org/calendar-locations/uxbridge-historical-centre/","address":{"@type":"PostalAddress","streetAddress":"7239 Concession 6","addressLocality":"Uxbridge","addressRegion":"Ontario","postalCode":"L9P 1N5","addressCountry":""},"telephone":"n/a","sameAs":""}},{"@context":"https://schema.org","@type":"Event","name":"Carolinian Canada webinar and 2026 AGM","description":"Seed Change for Systems Change: A Map to Transforming the Conservation Sector Followed by Carolinian Canada Annual General Meeting 2026 All Welcome! Join us for the Seed Change for Systems Change panel and AGM to where we will discuss what is really needed to bring forward a new era of conservation, rooted in reconciliation, collaboration,&hellip;","image":"","url":"https://caroliniancanada.ca/article/agm-2026","startDate":"2026-06-18T12:00:00-04:00","endDate":"2026-06-18T14:00:00-04:00","duration":"PT2H","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://caroliniancanada.ca/article/agm-2026"}},{"@context":"https://schema.org","@type":"Event","name":"Experience the Thickson\u2019s Woods Nature Reserve","description":"Virtually explore Thickson\u2019s Woods, a birding hotspot in Whitby. Ontario Nature is raising funds to support the transfer of 10 hectares of land from Thickson\u2019s Woods Land Trust to Ontario Nature and subsequent stewardship, which will create our first transit-accessible and urban nature reserve. Thickson\u2019s Woods is a rare gem: a migratory bird stopover and&hellip;","image":"","url":"https://ontarionature.org/eventcal/experience-the-thicksons-woods-nature-reserve-2/","startDate":"2026-06-23T12:00:00-04:00","endDate":"2026-06-23T13:03:00-04:00","duration":"PT1H3M","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","location":{"@type":"VirtualLocation","url":"https://ontarionature.org/eventcal/experience-the-thicksons-woods-nature-reserve-2/"}},{"@context":"https://schema.org","@type":"Event","name":"Nature is for Everyone \u2013 Guided Accessible Hike at H.N. Crossley Nature Reserve","description":"Join Ontario Nature staff on June 27, 2026, from 10:00AM to 11:30AM for an inclusive and accessible hike at the H.N. Crossley Nature Reserve for people of all ages, backgrounds, and abilities. This will be an excellent opportunity to learn more about biodiversity and ecology in your own backyard, while exploring the accessible trail at&hellip;","image":"","url":"https://www.tickettailor.com/events/ontarionature/2225637","startDate":"2026-06-27T10:00:00-04:00","endDate":"2026-06-27T11:30:00-04:00","duration":"PT1H30M","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@context":"https://schema.org","@type":"Place","name":"H.N. Crossley Nature Reserve","description":"","url":"https://ontarionature.org/calendar-locations/h-n-crossley-nature-reserve-2/","address":{"@type":"PostalAddress","streetAddress":"Burgess Road","addressLocality":"Rosseau","addressRegion":"Ontario","postalCode":"","addressCountry":""},"telephone":"n/a","sameAs":""}}]

X-SOURCE-URLS:{"Devilsfootbrew": "https://devilsfootbrew.com/event-detail/devils-foot-b-corp-celebration/"}
X-SOURCE-ID:devilsfootbrew
X-SOURCE:The Mule at Devils Foot
DTSTART;TZID=America/New_York:20261008T170000
DTEND;TZID=America/New_York:20261008T190000

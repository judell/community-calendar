X-SOURCE-URLS:{"Jackofthewood Events Ics": "https://jackofthewood.com/events/nobodys-darling-string-band-3-2026-09-05-2026-09-12-2026-09-19-2026-09-26-2026-10-03-2026-10-10-2026-10-17-2026-10-24-2026-10-31-2026-11-07/"}

X-SOURCE-URLS:{"Jack of the Wood": "https://jackofthewood.com/events/nobodys-darling-string-band-3-2026-08-08/", "Where Y'at AVL Music": "https://jackofthewood.com/events/nobodys-darling-string-band-3-2026-08-08/"}
X-SOURCE-URLS:{"Jackofthewood Events Ics": "https://jackofthewood.com/events/nobodys-darling-string-band-3-2026-08-08/"}
X-SOURCE-ID:jackofthewood_events_ics

BEGIN:VEVENT
SUMMARY:59.1 Precinct Meeting Potluck
DTSTART;TZID=America/Los_Angeles:20260806T150000
DTEND;TZID=America/Los_Angeles:20260806T163000
UID:95ae5daefdb85004ddeedff4fa0af64f@mobilize.us

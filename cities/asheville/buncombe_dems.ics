BEGIN:VEVENT
SUMMARY:Precinct 4.1 and Northern Neighbors Social\, with some Political A
 ction thrown in!
DTSTART;TZID=America/Los_Angeles:20261214T143000
DTEND;TZID=America/Los_Angeles:20261214T160000
UID:307195e647fd882e7e82e0f462e32293@mobilize.us

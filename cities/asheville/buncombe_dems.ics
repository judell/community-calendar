BEGIN:VEVENT
SUMMARY:Broad River (Precinct 37.1) information & organizing meeting
DTSTART;TZID=America/Los_Angeles:20261010T110000
DTEND;TZID=America/Los_Angeles:20261010T130000
UID:becb205b66a97ed45f473b486d91dd65@mobilize.us

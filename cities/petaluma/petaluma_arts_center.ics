  #block-yui_3_17_2_1_1776105973947_5479 {--sqs-block-content-flex: 0\; } #
 block-yui_3_17_2_1_1776105973947_5479 { --opacity: 100%\; --translate-x: 0
 px\; --translate-y: 0px\; --rotation: 0deg\; --scale-x: 100%\; --scale-y: 

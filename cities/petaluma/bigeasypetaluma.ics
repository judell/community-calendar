    <style>
      html,
      body {
        background: #0c0a08;
        color: #e7d6a6;
        margin: 0;
      }
      #root {
        background: #0c0a08;
      }
    </style>
    <link rel="icon" href="/bigeasypetaluma.com-favicon.ico" type="image/x-icon" sizes="any" />
    <link rel="apple-touch-icon" href="/bigeasypetaluma.com-favicon.ico" />
    <link rel="manifest" href="/manifest.json" />
    <title>The Big Easy — Underground Restaurant & Nightclub | Petaluma, CA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://firestore.googleapis.com" />

 a6 .sqs-html-content { } } @media screen and (max-width: 767px) { } Buy Ti
 ckets #block-6da137962e16e1d7616c { --sqs-block-content-flex: 0\; } #block
 -6da137962e16e1d7616c { --opacity: 100%\; --translate-x: 0px\; --translate
 -y: 0px\; --rotation: 0deg\; --scale-x: 100%\; --scale-y: 100%\; --skew-x:
  0deg\; --skew-y: 0deg\; --origin-x: 50%\; --origin-y: 50%\; opacity: var(

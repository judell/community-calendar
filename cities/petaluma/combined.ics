X-SOURCE-URLS:{"Meetup Mindfulnesspetaluma": "https://www.meetup.com/mindfulnesspetaluma/events/314491946/"}
X-SOURCE-ID:meetup_mindfulnesspetaluma
X-SOURCE:Meetup: Mindful Petaluma
UID:event_314491946@meetup.com
SEQUENCE:1

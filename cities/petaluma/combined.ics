SUMMARY:Summer U-Pick at Shone Farm
DTSTART;TZID=America/Los_Angeles:20260814T100000
DTEND;TZID=America/Los_Angeles:20260814T140000
DTSTAMP:20260701T151846Z
UID:20260814T170000Z-21266@calendar.santarosa.edu

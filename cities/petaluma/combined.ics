SUMMARY:Summer U-Pick at Shone Farm
DTSTART;TZID=America/Los_Angeles:20260828T100000
DTEND;TZID=America/Los_Angeles:20260828T140000
DTSTAMP:20260701T152652Z
UID:20260828T170000Z-21268@calendar.santarosa.edu

LAST-MODIFIED:20260525T161254Z
CLASS:PUBLIC
END:VEVENT
BEGIN:VEVENT
X-SOURCE-URLS:{"Meetup Meditate With A Monk In Sonoma County": "https://www.meetup.com/meditate-with-a-monk-in-sonoma-county/events/314949820/"}
X-SOURCE-ID:meetup_meditate_with_a_monk_in_sonoma_county
X-SOURCE:Meetup: Meditate with a Monk

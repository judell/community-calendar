BEGIN:VEVENT
X-SOURCE:SAROGN
UID:event_317032142@meetup.com
SEQUENCE:1
DTSTAMP:20261031T052723Z
DTSTART;TZID=America/Los_Angeles:20261121T180000
DTEND;TZID=America/Los_Angeles:20261121T210000
SUMMARY:Santa Rosa Game Night
DESCRIPTION:Santa Rosa Game Night\nAn evening of board games and cards pre
 ceded by pot luck snacks. Bring a game\, play what is there\, learn a new 
 game\, socialize\, eat! Members are welcoming and friendly\, ready to teac
 h new people how to play. Please\, no Crimes against Humanity.\nWe ask for
  a $2 donation to cover the cost.\n\nGame Night is the third Saturday of e
 very month unless otherwise noted. If cancelled\, you will receive an emai
 l notice. Lately we have a lot of no shows. Please take your reservation s
 eriously and give us advance notice if you cannot attend.\nIt is a good id
 ea to arrive at 6:00.
URL;VALUE=URI:https://www.meetup.com/sarogn/events/317032142/
STATUS:CONFIRMED
CREATED:20261018T090906Z
LAST-MODIFIED:20261018T090906Z
CLASS:PUBLIC
END:VEVENT

BEGIN:VEVENT
SUMMARY:Leading Outreach with Solidarity and Care
DTSTART;TZID=America/Los_Angeles:20260721T160000
DTEND;TZID=America/Los_Angeles:20260721T173000
UID:7fd8000d757d8e1d3d5388993d4c5b74@mobilize.us

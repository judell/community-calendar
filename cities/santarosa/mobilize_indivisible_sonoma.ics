BEGIN:VEVENT
SUMMARY:[Yolo County] Self-Directed Door Knocking — Eric Jones for Congr
 ess (CA-4)
DTSTART;TZID=America/Los_Angeles:20261010T090000
DTEND;TZID=America/Los_Angeles:20261010T210000
UID:467fa12109ae0f587cdaa6adeae1f59a@mobilize.us

BEGIN:VEVENT
SUMMARY:Eyes on ICE: Train-the-Trainer - Immigrants' Rights
DTSTART;TZID=America/Los_Angeles:20260420T170000
DTEND;TZID=America/Los_Angeles:20260420T180000
UID:166e8f42f045d9c46ae80de7730ba0d9@mobilize.us

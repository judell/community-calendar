BEGIN:VEVENT
SUMMARY:Trump Regime Takedown
DTSTART;TZID=America/Los_Angeles:20260502T120000
DTEND;TZID=America/Los_Angeles:20260502T140000
UID:3097fe666d20ce3ea8d1f845e5849e64@mobilize.us

BEGIN:VEVENT
X-SOURCE-URLS:{"North Bay Bohemian": "https://www.exploretock.com/gold-ridge-organic-farms/event/628788/holiday-cheeseboard-workshop-with-alli-keyser-marti-ccp-ccse"}

X-SOURCE-URLS:{"North Bay Bohemian": "https://jarvisconservatory.ticketspice.com/raveloneacts", "Press Democrat": "https://www.pressdemocrat.com/events/#/details/opera-film-two-ravel-one-act-operas-monte-carlo-opera/17896796/2026-09-12T13"}
X-SOURCE-URLS:{"North Bay Bohemian": "https://jarvisconservatory.ticketspice.com/raveloneacts"}

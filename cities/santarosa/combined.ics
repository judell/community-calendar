SUMMARY:Project Hail Mary - Fall Cinema Series
DTSTART;TZID=America/Los_Angeles:20260916T183000
DTEND;TZID=America/Los_Angeles:20260916T193000
DTSTAMP:20260903T120159Z
UID:20260917T013000Z-23951@calendar.santarosa.edu

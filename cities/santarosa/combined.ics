BEGIN:VEVENT
X-SOURCE-URLS:{"North Bay Bohemian": "https://www.bandsintown.com/e/108747470?app_id=pkvts0on0m&came_from=287&utm_medium=api&utm_source=partner_api&utm_campaign=event"}

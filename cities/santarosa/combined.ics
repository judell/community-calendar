X-SOURCE-URLS:{"North Bay Bohemian": "https://www.exploretock.com/brandlinestate/experience/565565/the-brandlin-wine-food-tasting-experience?date=2026-03-12&size=2&time=10%3A00", "Press Democrat": "https://www.pressdemocrat.com/events/#/details/the-brandlin-estate-wine-food-tasting-experience/18318441/2026-09-16T11"}
X-SOURCE-URLS:{"North Bay Bohemian": "https://www.exploretock.com/brandlinestate/experience/565565/the-brandlin-wine-food-tasting-experience?date=2026-03-12&size=2&time=10%3A00"}

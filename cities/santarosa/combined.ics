X-SOURCE-URLS:{"North Bay Bohemian": "https://bohemian.com/events-calendar/#/details/merry-bright/20329741/2026-12-06T13", "Press Democrat": "https://www.pressdemocrat.com/events/#/details/merry-bright/20329741/2026-12-06T13"}

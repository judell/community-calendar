X-SOURCE-URLS:{"North Bay Bohemian": "https://bohemian.com/events-calendar/#/details/intermediate-salsa-class/17159571/2026-11-10T18", "Press Democrat": "https://salsadancemarin.com/salsa-class-intermediate-tuesday/"}
X-SOURCE-URLS:{"North Bay Bohemian": "https://bohemian.com/events-calendar/#/details/intermediate-salsa-class/17159571/2026-11-10T18"}

SUMMARY:Sips and Stars
DTSTART;TZID=America/Los_Angeles:20261113T173000
DTEND;TZID=America/Los_Angeles:20261113T193000
DTSTAMP:20260905T041944Z
UID:7m3r0cm3f5do9mjm3bqqk02j35@google.com

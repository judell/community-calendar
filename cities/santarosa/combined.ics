X-SOURCE-URLS:{"North Bay Bohemian": "https://scriberocks.com/event/6712229/777494293/scribe-shady-oak-barrel-house", "Press Democrat": "https://scriberocks.com/event/6712229/777494293/scribe-shady-oak-barrel-house", "Visit Santa Rosa": "https://www.visitsantarosa.com/events/scribe-at-shady-oak-barrel-house/"}

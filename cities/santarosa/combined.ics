X-SOURCE-URLS:{"North Bay Bohemian": "https://www.westernhillsgarden.com/programs/pineneedlebasket2026", "Creative Sonoma": "https://creativesonoma.org/event/pine-needle-basketmaking-with-judith-thomas/", "Press Democrat": "https://www.westernhillsgarden.com/programs/pineneedlebasket2026"}
X-SOURCE-URLS:{"North Bay Bohemian": "https://www.westernhillsgarden.com/programs/pineneedlebasket2026"}

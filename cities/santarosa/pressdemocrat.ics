DTSTART;TZID=America/Los_Angeles:20260624T173000
DTEND;TZID=America/Los_Angeles:20260624T200000
UID:260607OPEM_M93hkigduZ9WXdSTQ
DESCRIPTION:You're invited: 2026 Petaluma People's Choice Awards Event
LOCATION:Flying Cloud

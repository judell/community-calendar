BEGIN:VEVENT
SUMMARY:Bocce\, Bites\, & Bottles
DTSTART;TZID=America/Los_Angeles:20260724T160000
DTEND;TZID=America/Los_Angeles:20260724T190000
UID:260703MGVwxSmxRkiPPUSK9lTlMA

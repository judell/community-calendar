BEGIN:VEVENT
SUMMARY:Club Member Wine Appreciation
DTSTART;TZID=America/Los_Angeles:20261111T173000
DTEND;TZID=America/Los_Angeles:20261111T183000
UID:260816ybALIEOGxk2qtl2zjGMVaw
DESCRIPTION:Club Member Wine Appreciation Wine Club Exclusive 5-6:30 p.m. 

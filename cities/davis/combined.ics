X-SOURCE-URLS:{"Visit Davis": "https://visitdavis.org/event/yoga-night-at-great-bear-vineyards-2/", "Visit Yolo": "https://visityolo.com/event/yoga-night-at-great-bear-vineyards-2/"}
X-SOURCE-URLS:{"Visitdavis": "https://visitdavis.org/event/yoga-night-at-great-bear-vineyards-2/"}
X-SOURCE-ID:visitdavis
X-SOURCE:Visit Davis, Visit Yolo
DTSTART;TZID=America/Los_Angeles:20260513T180000
DTEND;TZID=America/Los_Angeles:20260513T200000

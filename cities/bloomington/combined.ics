X-SOURCE-URLS:{"Browncountyplayhouse": "https://browncountyplayhouse.org/event/white-christmas-live-musical-theatre/2026-12-05/"}
X-SOURCE-ID:browncountyplayhouse
X-SOURCE:Brown County Playhouse
DTSTART;TZID=America/Indiana/Indianapolis:20261205T193000
DTEND;TZID=America/Indiana/Indianapolis:20261205T220000

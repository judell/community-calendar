X-SOURCE-URLS:{"IU Eskenazi School of Art": "https://events.iu.edu/live/events/2486300-interactive-frequencies-ii-a-multimedia-concert", "Architecture + Design": "https://events.iu.edu/live/events/2486300-interactive-frequencies-ii-a-multimedia-concert", "IU Jacobs School of Music": "https://events.iu.edu/live/events/2486300-interactive-frequencies-ii-a-multimedia-concert"}

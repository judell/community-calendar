DTSTART;TZID=America/Indiana/Indianapolis:20261005T120000
DTEND;TZID=America/Indiana/Indianapolis:20261005T220000
DTSTAMP:20260417T142538Z
UID:MEC-d14387be71d9f4739f36dd3051dfb343@browncounty.com__20261005

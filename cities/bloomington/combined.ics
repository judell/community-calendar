X-SOURCE-URLS:{"IU Media School": "https://events.iu.edu/live/events/2446637-vindication-swim-w-qampa-additional-films-and", "IU Cinema": "https://events.iu.edu/cinemaiub/event/2446637-vindication-swim-wqa-additional-films-and-guests", "Pillar Arts Community Calendar": "https://tockify.com/bloomington.arts.calendar/detail/2499/1794268800000"}

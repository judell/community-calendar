BEGIN:VEVENT
X-SOURCE-URLS:{"IU Arts & Humanities Institute": "https://events.iu.edu/live/events/2379075-the-declaration-of-independence-the-signers", "IU Bloomington Libraries": "https://events.iu.edu/libraries/event/2379075-the-declaration-of-independence-the-signers"}

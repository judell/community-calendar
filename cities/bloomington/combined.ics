X-SOURCE-URLS:{"IU beINvolved Student Orgs": "https://beinvolved.indiana.edu/event/12874711", "IU Eskenazi School of Art": "https://events.iu.edu/live/events/2450203-eiteljorg-artist-in-residence-visiting-lecture-susan", "Architecture + Design": "https://events.iu.edu/live/events/2450203-eiteljorg-artist-in-residence-visiting-lecture-susan", "Eskenazi Museum of Art": "https://events.iu.edu/artmuseum/event/2450203-eiteljorg-artist-in-residence-visiting-lecture-susan", "IU First Nations Center": "https://events.iu.edu/live/events/2450203-eiteljorg-artist-in-residence-visiting-lecture-susan"}

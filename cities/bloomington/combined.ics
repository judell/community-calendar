X-SOURCE-URLS:{"IU Eskenazi School of Art": "https://events.iu.edu/live/events/2430763-lilly-library-photography-collection-visit", "Architecture + Design": "https://events.iu.edu/live/events/2430763-lilly-library-photography-collection-visit", "Eskenazi Museum of Art": "https://events.iu.edu/artmuseum/event/2430763-lilly-library-photography-collection-visit", "IU Bloomington Libraries": "https://events.iu.edu/live/events/2430763-lilly-library-photography-collection-visit"}

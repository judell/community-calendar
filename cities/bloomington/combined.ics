SUMMARY:Story: Sajik Kim exhibition
DTSTART;VALUE=DATE:20261018
DTEND;VALUE=DATE:20261019
DTSTAMP:20260818T163935Z
UID:20261018T040000Z-2385188@events.iu.edu

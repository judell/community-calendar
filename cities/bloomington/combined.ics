X-SOURCE-URLS:{"IU Cinema": "https://events.iu.edu/cinemaiub/event/2446645-manhunter-the-final-cut-additional-films-and", "Pillar Arts Community Calendar": "https://tockify.com/bloomington.arts.calendar/detail/2506/1794873600000"}
X-SOURCE-URLS:{"Events Livewhale 81": "https://events.iu.edu/cinemaiub/event/2446645-manhunter-the-final-cut-additional-films-and"}
X-SOURCE-ID:events_livewhale_81

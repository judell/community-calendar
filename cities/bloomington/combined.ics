X-SOURCE-URLS:{"IU Eskenazi School of Art": "https://events.iu.edu/live/events/2154820-common-threads", "Architecture + Design": "https://events.iu.edu/live/events/2154820-common-threads", "Eskenazi Museum of Art": "https://events.iu.edu/artmuseum/event/2298011-common-threads"}

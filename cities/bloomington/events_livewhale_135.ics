 serif\; font-size: 14px\; font-style: normal\; font-variant-ligatures: no
 rmal\; font-variant-caps: normal\; font-weight: 400\; letter-spacing: nor
 mal\; orphans: 2\; text-align: start\; text-indent: 0px\; text-transform:
  none\; widows: 2\; word-spacing: 0px\; -webkit-text-stroke-width: 0px\; 
 white-space: normal\; background-color: #ffffff\; text-decoration-thickne

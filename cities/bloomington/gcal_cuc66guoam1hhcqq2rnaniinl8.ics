BEGIN:VEVENT
X-SOURCE:Bloomington Bicycle Club
DTSTART;TZID=America/New_York:20230808T174500
DTEND;TZID=America/New_York:20230808T204500
DTSTAMP:20260905T041501Z
UID:1v04bd50vmk9nh42ouber307fk@google.com

BEGIN:VEVENT
SUMMARY:A Night of Art and Fun
DTSTART;TZID=America/Los_Angeles:20261022T153000
DTEND;TZID=America/Los_Angeles:20261022T173000
UID:c6dc1cd0110da04e930dfc400b78b382@mobilize.us

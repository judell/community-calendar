X-SOURCE-URLS:{"Jccmetrowest": "https://jccmetrowest.org/event/hava-nagilia/"}
X-SOURCE-ID:jccmetrowest
X-SOURCE:JCC MetroWest
DTSTART;TZID=America/New_York:20261224T190000
DTEND;TZID=America/New_York:20261224T210000

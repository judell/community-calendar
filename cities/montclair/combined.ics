X-SOURCE-URLS:{"Montclairlocal": "https://montclairlocal.news/event/theater-league-of-clifton-announces-auditions-for-1776/2026-11-10/"}
X-SOURCE-ID:montclairlocal
X-SOURCE:Montclair Local News
DTSTART;TZID=America/New_York:20261110T190000
DTEND;TZID=America/New_York:20261110T210000

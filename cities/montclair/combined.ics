X-SOURCE-URLS:{"Jccmetrowest": "https://jccmetrowest.org/event/mind-body-connection/"}
X-SOURCE-ID:jccmetrowest
X-SOURCE:JCC MetroWest
DTSTART;TZID=America/New_York:20261208T133000
DTEND;TZID=America/New_York:20261208T143000

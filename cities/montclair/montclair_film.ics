BEGIN:VEVENT
SUMMARY:Blind Chance
DTSTART;TZID=America/New_York:20260927T140000
DTEND;TZID=America/New_York:20260927T140000
UID:f0472b4aac195556c7614d32da594e10@montclairfilm.org
DESCRIPTION:Witek runs after a train. Three variations follow on how such 
 a seemingly banal incident could influence the rest of Witek's life.
LOCATION:The Clairidge\, 486 Bloomfield Avenue\, Montclair\, NJ 07042
URL:https://www.montclairfilm.org/events/blindchance/
X-SOURCE:Montclair Film
END:VEVENT
BEGIN:VEVENT
SUMMARY:PAW Patrol: The Dino Movie
